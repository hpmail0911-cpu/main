//@version=5
strategy("2.6.2026 DRAFT MGC1! PT RUN TESt 11.21.2025 80% WIN RATE SYSTEM — Strategy + Alert-Only (TradersPost) — 10-Point Confluence",
     overlay=true,
     initial_capital=25000,
     pyramiding=0,
     process_orders_on_close=true,
     max_bars_back=500)
// =====================================================================
// 🎯 MGC 80% WIN RATE SYSTEM (ALERT ONLY)
// =====================================================================
// Strategy + alert-only hybrid:
// - Use strategy orders for backtesting when enabled
// - Use alert() JSON webhooks for live TradersPost automation
// - Maintains internal state for alert sequencing/metrics
//
// Recommended TradingView alert:
// - Condition: "Any alert() function call"
// - Frequency: "Once per bar close"
// =====================================================================
// ==============================
// 🎯 INSTRUMENT VERIFICATION
// ==============================
isMGC = str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "GC")
if not isMGC
    runtime.error("⚠️ This indicator is optimized for MGC/GC only. Please switch to an MGC chart.")
// ==============================
// 📊 CONFLUENCE SETTINGS
// ==============================
minConfluenceScore = input.int(7, "Minimum Confluence Score (7-10)", minval=6, maxval=10,
     tooltip="Higher = fewer trades but higher quality. 7 is the intended default.")
adxThreshold = input.float(30.0, "ADX Threshold (Strong Trends Only)", minval=20.0, maxval=40.0)
minTrendStrength = input.float(0.40, "Min Trend Strength", minval=0.30, maxval=0.60)
maxTradesPerDay = input.int(5, "Max Trades Per Day", minval=3, maxval=8)
minBarsBetweenTrades = input.int(15, "Min Bars Between Trades", minval=10, maxval=30)
volumeRatioMin = input.float(1.5, "Volume Ratio Minimum", minval=1.2, maxval=2.0)
srTolerance = input.float(0.3, "S/R Tolerance (ATR)", minval=0.2, maxval=0.5)
// Make signals cooperate (avoid long/short conflicts)
scoreDominance = input.int(2, "Min Score Dominance (avoid conflicts)", minval=0, maxval=5,
     tooltip="Requires the chosen direction score to beat the opposite direction by this margin.")
avoidOpposingSR = input.bool(true, "Avoid Opposing S/R (directional filter)",
     tooltip="Longs blocked near resistance; shorts blocked near support.")
// ==============================
// 🧠 CONFLUENCE LEVEL SYSTEM (15 LEVELS)
// ==============================
group_conf = "🧠 Confluence Levels"
confluenceLevel = input.int(11, "Confluence Level (1-15)", minval=1, maxval=15, group=group_conf,
     tooltip="Progressive filtering: 1-3 minimal, 4-6 volume, 7-9 momentum+trend, 10-12 session+strict, 13-15 ultra strict.")
volumeConfirmRatio = input.float(0.6, "Volume Confirm Ratio (x avg)", minval=0.3, maxval=1.5, group=group_conf)
strongVolumeRatio = input.float(1.2, "Strong Volume Ratio (x avg)", minval=0.8, maxval=3.0, group=group_conf)
stochLen = input.int(6, "Stochastic Length", minval=3, maxval=20, group=group_conf)
stochSmoothK = input.int(3, "Stochastic K Smooth", minval=1, maxval=10, group=group_conf)
stochSmoothD = input.int(3, "Stochastic D Smooth", minval=1, maxval=10, group=group_conf)
rsiMomentumLongMin = input.int(50, "RSI Momentum Long Min", minval=30, maxval=70, group=group_conf)
rsiMomentumLongMax = input.int(70, "RSI Momentum Long Max", minval=50, maxval=80, group=group_conf)
rsiMomentumShortMin = input.int(30, "RSI Momentum Short Min", minval=20, maxval=50, group=group_conf)
rsiMomentumShortMax = input.int(50, "RSI Momentum Short Max", minval=30, maxval=70, group=group_conf)
rsiStrongLongMin = input.int(60, "RSI Strong Long Min", minval=40, maxval=90, group=group_conf)
rsiStrongShortMax = input.int(40, "RSI Strong Short Max", minval=10, maxval=60, group=group_conf)
stochRangeMin = input.int(25, "Stoch Range Min", minval=5, maxval=50, group=group_conf)
stochRangeMax = input.int(75, "Stoch Range Max", minval=50, maxval=95, group=group_conf)
stochStrongLongMin = input.int(70, "Stoch Strong Long Min", minval=55, maxval=95, group=group_conf)
stochStrongShortMax = input.int(30, "Stoch Strong Short Max", minval=5, maxval=45, group=group_conf)
atrExpandLen = input.int(20, "ATR Expand Length", minval=5, maxval=100, group=group_conf)
atrExpandRatio = input.float(1.05, "ATR Expand Ratio", minval=1.0, maxval=2.0, group=group_conf)
// ==============================
// 🏆 HIGH WIN RATE MODE (OPTIONAL)
// ==============================
group_hw = "🏆 High Win Rate Mode"
enableHighWinRateMode = input.bool(false, "Enable High Win Rate Mode", group=group_hw)
quickTpMultiplier = input.float(0.6, "Quick TP Multiplier", minval=0.3, maxval=1.0, group=group_hw)
widerSlMultiplier = input.float(1.5, "Wider SL Multiplier", minval=1.0, maxval=2.5, group=group_hw)
// ==============================
// 📈 INDICATOR SUITE (OPTIONAL)
// ==============================
group_ind = "📈 Indicator Suite"
envelopeLen = input.int(12, "Envelope Length", minval=5, maxval=50, group=group_ind)
envelopeDev = input.float(0.8, "Envelope Deviation %", minval=0.2, maxval=2.0, group=group_ind)
supertrendAtrPeriod = input.int(8, "SuperTrend ATR Period", minval=5, maxval=20, group=group_ind)
supertrendFactor = input.float(2.2, "SuperTrend ATR Factor", minval=1.0, maxval=5.0, group=group_ind)
showExtraIndicators = input.bool(false, "Show Envelope/SuperTrend", group=group_ind)
// ==============================
// 🕒 SESSION FILTERS
// ==============================
tradingHoursOnly = input.bool(true, "US Trading Hours Only")
currentTime = math.round(hour * 100 + minute)
inTradingHours = currentTime >= 930 and currentTime <= 1550
sessionOK = not tradingHoursOnly or inTradingHours
// Institutional time filters (no-trade windows)
blockFirstMinutes = input.int(5, "Block First N Minutes After Open", minval=0, maxval=60,
     tooltip="Avoid the opening volatility/whipsaws.")
blockLastMinutes = input.int(5, "Block Last N Minutes Before Close", minval=0, maxval=60,
     tooltip="Avoid end-of-session liquidity swings.")
blockLunch = input.bool(false, "Block Lunch Window")
lunchStartHHMM = input.int(1200, "Lunch Start (HHMM)", minval=0, maxval=2359)
lunchEndHHMM = input.int(1330, "Lunch End (HHMM)", minval=0, maxval=2359)
blockWindow1 = input.bool(false, "Block Custom Window #1")
window1StartHHMM = input.int(1000, "Window #1 Start (HHMM)", minval=0, maxval=2359)
window1EndHHMM = input.int(1015, "Window #1 End (HHMM)", minval=0, maxval=2359)
blockWindow2 = input.bool(false, "Block Custom Window #2")
window2StartHHMM = input.int(1400, "Window #2 Start (HHMM)", minval=0, maxval=2359)
window2EndHHMM = input.int(1415, "Window #2 End (HHMM)", minval=0, maxval=2359)
f_hhmm_to_min(hhmm) =>
    hh = math.floor(hhmm / 100)
    mm = hhmm - (hh * 100)
    hh * 60 + mm
openMin = f_hhmm_to_min(930)
closeMin = f_hhmm_to_min(1550)
nowMin = hour * 60 + minute
inOpenBlock = blockFirstMinutes > 0 and nowMin >= openMin and nowMin < (openMin + blockFirstMinutes)
inCloseBlock = blockLastMinutes > 0 and nowMin <= closeMin and nowMin > (closeMin - blockLastMinutes)
inLunchBlock = blockLunch and nowMin >= f_hhmm_to_min(lunchStartHHMM) and nowMin <= f_hhmm_to_min(lunchEndHHMM)
inCustom1 = blockWindow1 and nowMin >= f_hhmm_to_min(window1StartHHMM) and nowMin <= f_hhmm_to_min(window1EndHHMM)
inCustom2 = blockWindow2 and nowMin >= f_hhmm_to_min(window2StartHHMM) and nowMin <= f_hhmm_to_min(window2EndHHMM)
timeWindowsOK = not (inOpenBlock or inCloseBlock or inLunchBlock or inCustom1 or inCustom2)
// ==============================
// 🌍 GLOBAL SESSIONS (24/7)
// ==============================
group_session = "🌍 Global Sessions"
useGlobalSessions = input.bool(true, "Enable Global Sessions", group=group_session)
sessionTzOffset = input.int(-5, "Timezone Offset from UTC (ET=-5)", minval=-12, maxval=14, group=group_session)
enableAsianSession = input.bool(true, "Asian Session 19:00-03:00 ET", group=group_session)
enableLondonSession = input.bool(true, "London Session 03:00-12:00 ET", group=group_session)
enableNySession = input.bool(false, "NY Session 09:30-16:00 ET", group=group_session)
enableUaeSession = input.bool(true, "UAE Session 00:00-08:00 ET", group=group_session)
enablePreMarket = input.bool(false, "US Pre-Market 06:00-09:30 ET", group=group_session)
enableAfterHours = input.bool(false, "US After-Hours 16:00-17:00 ET", group=group_session)
enableNoTradeZone = input.bool(true, "No-Trade Zone 00:00-06:00 ET", group=group_session)
noTradeStartHHMM = input.int(0, "No-Trade Start (HHMM)", minval=0, maxval=2359, group=group_session)
noTradeEndHHMM = input.int(600, "No-Trade End (HHMM)", minval=0, maxval=2359, group=group_session)
f_in_window(_startMin, _endMin, _nowMin) =>
    _startMin <= _endMin ? (_nowMin >= _startMin and _nowMin < _endMin) : (_nowMin >= _startMin or _nowMin < _endMin)
etHour = (hour + sessionTzOffset + 24) % 24
etNowMin = etHour * 60 + minute
asianStart = f_hhmm_to_min(1900)
asianEnd = f_hhmm_to_min(300)
londonStart = f_hhmm_to_min(300)
londonEnd = f_hhmm_to_min(1200)
nyStart = f_hhmm_to_min(930)
nyEnd = f_hhmm_to_min(1600)
uaeStart = f_hhmm_to_min(0)
uaeEnd = f_hhmm_to_min(800)
premarketStart = f_hhmm_to_min(600)
premarketEnd = f_hhmm_to_min(930)
afterHoursStart = f_hhmm_to_min(1600)
afterHoursEnd = f_hhmm_to_min(1700)
inAsian = enableAsianSession and f_in_window(asianStart, asianEnd, etNowMin)
inLondon = enableLondonSession and f_in_window(londonStart, londonEnd, etNowMin)
inNy = enableNySession and f_in_window(nyStart, nyEnd, etNowMin)
inUae = enableUaeSession and f_in_window(uaeStart, uaeEnd, etNowMin)
inPreMarket = enablePreMarket and f_in_window(premarketStart, premarketEnd, etNowMin)
inAfterHours = enableAfterHours and f_in_window(afterHoursStart, afterHoursEnd, etNowMin)
noTradeStartMin = f_hhmm_to_min(noTradeStartHHMM)
noTradeEndMin = f_hhmm_to_min(noTradeEndHHMM)
inNoTradeZone = enableNoTradeZone and f_in_window(noTradeStartMin, noTradeEndMin, etNowMin)
globalSessionOK = not useGlobalSessions or ((inAsian or inLondon or inNy or inUae or inPreMarket or inAfterHours) and not inNoTradeZone)
sessionFilterOK = useGlobalSessions ? globalSessionOK : sessionOK
timeWindowFilterOK = useGlobalSessions ? true : timeWindowsOK
// ==============================
// 📊 HIGHER TIMEFRAME CONFIRMATION
// ==============================
htfTimeframe = input.timeframe("15", "Higher Timeframe",
     tooltip="15m for 5m charts, 1H for 15m charts")
htf_close = request.security(syminfo.tickerid, htfTimeframe, close)
htf_ema20 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 20))
htf_ema50 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 50))
htf_bullish = htf_close > htf_ema20 and htf_ema20 > htf_ema50
htf_bearish = htf_close < htf_ema20 and htf_ema20 < htf_ema50
// Institutional filter option: require HTF alignment (not just "points")
requireHtfAlignment = input.bool(true, "Require HTF Alignment (institutional filter)",
     tooltip="If ON, longs require HTF bullish and shorts require HTF bearish.")
// Optional MTF (mid-timeframe) confirmation
useMtfConfirmation = input.bool(false, "Use MTF Confirmation (optional)")
mtfTimeframe = input.timeframe("60", "Mid Timeframe (MTF)", tooltip="Example: 60m. Used only if MTF confirmation is enabled.")
mtf_close = request.security(syminfo.tickerid, mtfTimeframe, close)
mtf_ema20 = request.security(syminfo.tickerid, mtfTimeframe, ta.ema(close, 20))
mtf_ema50 = request.security(syminfo.tickerid, mtfTimeframe, ta.ema(close, 50))
mtf_bullish = mtf_close > mtf_ema20 and mtf_ema20 > mtf_ema50
mtf_bearish = mtf_close < mtf_ema20 and mtf_ema20 < mtf_ema50
// ==============================
// 🕰️ MULTI-TIMEFRAME CONFIRMATION (3 HTFs)
// ==============================
group_mtf = "🕰️ MTF Confirmation"
mtfMode = input.string("FILTER", "MTF Mode", options=["FILTER", "CONFIRMATION", "ADVISORY"], group=group_mtf,
     tooltip="FILTER blocks trades if misaligned. CONFIRMATION/ADVISORY are non-blocking.")
mtfAlignmentThresholdPct = input.float(66.0, "MTF Alignment Threshold (%)", minval=50.0, maxval=100.0, group=group_mtf)
htf1_tf = input.timeframe("15", "HTF1 (15m)", group=group_mtf)
htf2_tf = input.timeframe("60", "HTF2 (60m)", group=group_mtf)
htf3_tf = input.timeframe("240", "HTF3 (240m)", group=group_mtf)
enableTrendOverride = input.bool(true, "Trend Override Bypass", group=group_mtf)
enableImpulseOverride = input.bool(false, "Impulse Override Bypass", group=group_mtf)
impulseAtrMult = input.float(1.1, "Impulse Candle ATR Mult", minval=0.8, maxval=3.0, group=group_mtf)
impulseVolumeMult = input.float(1.8, "Impulse Volume Mult", minval=1.0, maxval=5.0, group=group_mtf)
// ==============================
// 📈 CORE INDICATORS
// ==============================
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
ema_bullish_aligned = ema9 > ema21 and ema21 > ema50 and ema50 > ema100 and ema100 > ema200
ema_bearish_aligned = ema9 < ema21 and ema21 < ema50 and ema50 < ema100 and ema100 < ema200
hullLen = 20
hma(src, len) =>
    half_length = math.round(len / 2)
    sqrt_length = math.round(math.sqrt(len))
    ta.wma(2 * ta.wma(src, half_length) - ta.wma(src, len), sqrt_length)
f_percent_rank(_series, _length) =>
    int len = math.min(_length, bar_index + 1)
    float count = 0.0
    for i = 0 to len - 1
        if _series[i] <= _series
            count += 1.0
    len > 0 ? (count / len) * 100.0 : na
hull = hma(close, hullLen)
hull_bullish = hull > hull[1] and hull[1] > hull[2]
hull_bearish = hull < hull[1] and hull[1] < hull[2]
adxLen = 14
f_adx(_len) =>
    upMove = high - high[1]
    downMove = low[1] - low
    plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
    tr = ta.tr(true)
    atr_val = ta.rma(tr, _len)
    plusDI = atr_val != 0 ? 100 * ta.rma(plusDM, _len) / atr_val : 0.0
    minusDI = atr_val != 0 ? 100 * ta.rma(minusDM, _len) / atr_val : 0.0
    dx = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
    ta.rma(dx, _len)
adx = f_adx(adxLen)
strongTrend = adx > adxThreshold
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
macd_bullish = macdLine > signalLine and histLine > 0
macd_bearish = macdLine < signalLine and histLine < 0
rsi = ta.rsi(close, 14)
rsi_neutral = rsi > 35 and rsi < 65
stochRaw = ta.stoch(high, low, close, stochLen)
stochK = ta.sma(stochRaw, stochSmoothK)
stochD = ta.sma(stochK, stochSmoothD)
volumeMA = ta.sma(volume, 20)
volumeSpike = volume > volumeMA * volumeRatioMin
atr = ta.atr(14)
envBasis = ta.sma(close, envelopeLen)
upperEnv = envBasis * (1 + envelopeDev / 100.0)
lowerEnv = envBasis * (1 - envelopeDev / 100.0)
[superTrendLine, superTrendDir] = ta.supertrend(supertrendFactor, supertrendAtrPeriod)
// Institutional volatility/spike filters (avoid news/whipsaw candles)
useVolatilityGuard = input.bool(true, "Volatility/Spike Guard (institutional)")
maxAtrPct = input.float(0.60, "Max ATR% of Price", minval=0.10, maxval=3.0,
     tooltip="Blocks entries when ATR is too large relative to price (news/high-vol regimes).")
maxRangeATR = input.float(2.5, "Max Candle Range (ATR)", minval=0.5, maxval=10.0,
     tooltip="Blocks entries on huge candles relative to ATR (spike candles).")
atrPct = close != 0 ? (atr / close) * 100.0 : na
rangeAtr = atr != 0 ? (high - low) / atr : na
volatilityOK = not useVolatilityGuard or ((not na(atrPct) and atrPct <= maxAtrPct) and (not na(rangeAtr) and rangeAtr <= maxRangeATR))
// ==============================
// 📊 SUPPORT/RESISTANCE DETECTION
// ==============================
pivotHighs = ta.pivothigh(high, 5, 5)
pivotLows = ta.pivotlow(low, 5, 5)
var float[] resistanceLevels = array.new_float(0)
var float[] supportLevels = array.new_float(0)
if not na(pivotHighs)
    array.push(resistanceLevels, pivotHighs)
    if array.size(resistanceLevels) > 10
        array.shift(resistanceLevels)
if not na(pivotLows)
    array.push(supportLevels, pivotLows)
    if array.size(supportLevels) > 10
        array.shift(supportLevels)
// Track most recent swing pivots (for structure-aware stop placement)
var float lastPivotHigh = na
var float lastPivotLow = na
if not na(pivotHighs)
    lastPivotHigh := pivotHighs
if not na(pivotLows)
    lastPivotLow := pivotLows
nearSupport = false
nearResistance = false
if array.size(supportLevels) > 0
    for i = 0 to array.size(supportLevels) - 1
        level = array.get(supportLevels, i)
        if math.abs(close - level) < atr * srTolerance
            nearSupport := true
            break
if array.size(resistanceLevels) > 0
    for i = 0 to array.size(resistanceLevels) - 1
        level = array.get(resistanceLevels, i)
        if math.abs(close - level) < atr * srTolerance
            nearResistance := true
            break
// ==============================
// 📊 MARKET STRUCTURE
// ==============================
// Use pivot-to-pivot structure (more realistic than comparing to oldest highest/lowest values).
var float prevPivotHigh = na
var float prevPivotLow = na
var float lastPivotHigh2 = na
var float lastPivotLow2 = na
if not na(pivotHighs)
    prevPivotHigh := lastPivotHigh2
    lastPivotHigh2 := pivotHighs
if not na(pivotLows)
    prevPivotLow := lastPivotLow2
    lastPivotLow2 := pivotLows
haveHighs = not na(lastPivotHigh2) and not na(prevPivotHigh)
haveLows = not na(lastPivotLow2) and not na(prevPivotLow)
cleanBullStructure = haveHighs and haveLows and (lastPivotHigh2 > prevPivotHigh) and (lastPivotLow2 > prevPivotLow)
cleanBearStructure = haveHighs and haveLows and (lastPivotHigh2 < prevPivotHigh) and (lastPivotLow2 < prevPivotLow)
// ==============================
// 📊 TREND STRENGTH CALCULATION
// ==============================
trendLookback = 50
priceRange = ta.highest(high, trendLookback) - ta.lowest(low, trendLookback)
priceMove = close - close[trendLookback]
trendStrength = priceRange > 0 ? math.abs(priceMove) / priceRange : 0.0
strongTrendDirection = trendStrength > minTrendStrength
// ==============================
// 🔎 7 CONFLUENCE FACTORS
// ==============================
volumeConfirm = volume >= volumeMA * volumeConfirmRatio
strongVolume = volume >= volumeMA * strongVolumeRatio
rsiLongMinEff = enableHighWinRateMode ? 40 : rsiMomentumLongMin
rsiLongMaxEff = enableHighWinRateMode ? 65 : rsiMomentumLongMax
rsiShortMinEff = enableHighWinRateMode ? 35 : rsiMomentumShortMin
rsiShortMaxEff = enableHighWinRateMode ? 60 : rsiMomentumShortMax
stochMinEff = enableHighWinRateMode ? 25 : stochRangeMin
stochMaxEff = enableHighWinRateMode ? 75 : stochRangeMax
momentumAlignLong = rsi >= rsiLongMinEff and rsi <= rsiLongMaxEff and stochK >= stochMinEff and stochK <= stochMaxEff and stochK > stochD
momentumAlignShort = rsi >= rsiShortMinEff and rsi <= rsiShortMaxEff and stochK >= stochMinEff and stochK <= stochMaxEff and stochK < stochD
strongMomentumLong = rsi >= rsiStrongLongMin and stochK >= stochStrongLongMin and stochK > stochD
strongMomentumShort = rsi <= rsiStrongShortMax and stochK <= stochStrongShortMax and stochK < stochD
trendModerate = adx >= adxFloorThreshold
trendStrong = adx >= adxThreshold
priceActionLong = close > open and close > close[1]
priceActionShort = close < open and close < close[1]
atrSma = ta.sma(atr, atrExpandLen)
atrExpanding = atrSma != 0 ? atr > atrSma * atrExpandRatio : false
// ==============================
// 🎯 10-POINT CONFLUENCE SCORING
// ==============================
var int confluenceLong = 0
var int confluenceShort = 0
confluenceLong := 0
confluenceShort := 0
// 1) HTF confirm (2 pts)
if htf_bullish
    confluenceLong += 2
if htf_bearish
    confluenceShort += 2
// 2) ADX strong (1 pt)
if strongTrend
    confluenceLong += 1
    confluenceShort += 1
// 3) EMA aligned (1 pt)
if ema_bullish_aligned
    confluenceLong += 1
if ema_bearish_aligned
    confluenceShort += 1
// 4) Hull direction (1 pt)
if hull_bullish
    confluenceLong += 1
if hull_bearish
    confluenceShort += 1
// 5) MACD (1 pt)
if macd_bullish
    confluenceLong += 1
if macd_bearish
    confluenceShort += 1
// 6) RSI neutral (1 pt)
if rsi_neutral
    confluenceLong += 1
    confluenceShort += 1
// 7) Near S/R (1 pt)
if nearSupport
    confluenceLong += 1
if nearResistance
    confluenceShort += 1
// 8) Volume spike (1 pt)
if volumeSpike
    confluenceLong += 1
    confluenceShort += 1
// 9) Clean structure (1 pt)
if cleanBullStructure
    confluenceLong += 1
if cleanBearStructure
    confluenceShort += 1
// 10) Trend strength (1 pt)
if strongTrendDirection and close > close[trendLookback]
    confluenceLong += 1
if strongTrendDirection and close < close[trendLookback]
    confluenceShort += 1
// ==============================
// 🧠 CONFLUENCE LEVEL GATES (15 LEVELS)
// ==============================
confluenceTier = confluenceLevel <= 3 ? 1 : confluenceLevel <= 6 ? 2 : confluenceLevel <= 9 ? 3 : confluenceLevel <= 12 ? 4 : 5
confluenceLevelOKLong =
     confluenceTier == 1 ? true :
     confluenceTier == 2 ? volumeConfirm :
     confluenceTier == 3 ? (volumeConfirm and momentumAlignLong and trendModerate) :
     confluenceTier == 4 ? (volumeConfirm and strongVolume and momentumAlignLong and trendModerate and priceActionLong and atrExpanding and sessionFilterOK) :
     (strongVolume and momentumAlignLong and strongMomentumLong and trendStrong and priceActionLong and atrExpanding and sessionFilterOK)
confluenceLevelOKShort =
     confluenceTier == 1 ? true :
     confluenceTier == 2 ? volumeConfirm :
     confluenceTier == 3 ? (volumeConfirm and momentumAlignShort and trendModerate) :
     confluenceTier == 4 ? (volumeConfirm and strongVolume and momentumAlignShort and trendModerate and priceActionShort and atrExpanding and sessionFilterOK) :
     (strongVolume and momentumAlignShort and strongMomentumShort and trendStrong and priceActionShort and atrExpanding and sessionFilterOK)
// ==============================
// 🕰️ MTF ALIGNMENT CHECKS (3 HTFs)
// ==============================
mtfEmaFast1 = request.security(syminfo.tickerid, htf1_tf, ta.ema(close, 20))
mtfEmaSlow1 = request.security(syminfo.tickerid, htf1_tf, ta.ema(close, 50))
mtfEmaFast2 = request.security(syminfo.tickerid, htf2_tf, ta.ema(close, 20))
mtfEmaSlow2 = request.security(syminfo.tickerid, htf2_tf, ta.ema(close, 50))
mtfEmaFast3 = request.security(syminfo.tickerid, htf3_tf, ta.ema(close, 20))
mtfEmaSlow3 = request.security(syminfo.tickerid, htf3_tf, ta.ema(close, 50))
mtfHull1 = request.security(syminfo.tickerid, htf1_tf, hma(close, hullLen))
mtfHull2 = request.security(syminfo.tickerid, htf2_tf, hma(close, hullLen))
mtfHull3 = request.security(syminfo.tickerid, htf3_tf, hma(close, hullLen))
mtfRsi1 = request.security(syminfo.tickerid, htf1_tf, ta.rsi(close, 14))
mtfRsi2 = request.security(syminfo.tickerid, htf2_tf, ta.rsi(close, 14))
mtfRsi3 = request.security(syminfo.tickerid, htf3_tf, ta.rsi(close, 14))
mtfVol1 = request.security(syminfo.tickerid, htf1_tf, volume)
mtfVol2 = request.security(syminfo.tickerid, htf2_tf, volume)
mtfVol3 = request.security(syminfo.tickerid, htf3_tf, volume)
mtfVolMa1 = request.security(syminfo.tickerid, htf1_tf, ta.sma(volume, 20))
mtfVolMa2 = request.security(syminfo.tickerid, htf2_tf, ta.sma(volume, 20))
mtfVolMa3 = request.security(syminfo.tickerid, htf3_tf, ta.sma(volume, 20))
mtfTrendLong1 = mtfEmaFast1 > mtfEmaSlow1
mtfTrendShort1 = mtfEmaFast1 < mtfEmaSlow1
mtfTrendLong2 = mtfEmaFast2 > mtfEmaSlow2
mtfTrendShort2 = mtfEmaFast2 < mtfEmaSlow2
mtfTrendLong3 = mtfEmaFast3 > mtfEmaSlow3
mtfTrendShort3 = mtfEmaFast3 < mtfEmaSlow3
mtfHullLong1 = mtfHull1 > mtfHull1[1]
mtfHullShort1 = mtfHull1 < mtfHull1[1]
mtfHullLong2 = mtfHull2 > mtfHull2[1]
mtfHullShort2 = mtfHull2 < mtfHull2[1]
mtfHullLong3 = mtfHull3 > mtfHull3[1]
mtfHullShort3 = mtfHull3 < mtfHull3[1]
mtfRsiLong1 = mtfRsi1 >= rsiLongMinEff and mtfRsi1 <= rsiLongMaxEff
mtfRsiShort1 = mtfRsi1 <= rsiShortMaxEff and mtfRsi1 >= rsiShortMinEff
mtfRsiLong2 = mtfRsi2 >= rsiLongMinEff and mtfRsi2 <= rsiLongMaxEff
mtfRsiShort2 = mtfRsi2 <= rsiShortMaxEff and mtfRsi2 >= rsiShortMinEff
mtfRsiLong3 = mtfRsi3 >= rsiLongMinEff and mtfRsi3 <= rsiLongMaxEff
mtfRsiShort3 = mtfRsi3 <= rsiShortMaxEff and mtfRsi3 >= rsiShortMinEff
mtfVolOk1 = mtfVol1 >= mtfVolMa1 * volumeConfirmRatio
mtfVolOk2 = mtfVol2 >= mtfVolMa2 * volumeConfirmRatio
mtfVolOk3 = mtfVol3 >= mtfVolMa3 * volumeConfirmRatio
mtfAlignedCountLong = (mtfTrendLong1 ? 1 : 0) + (mtfTrendLong2 ? 1 : 0) + (mtfTrendLong3 ? 1 : 0) +
     (mtfHullLong1 ? 1 : 0) + (mtfHullLong2 ? 1 : 0) + (mtfHullLong3 ? 1 : 0) +
     (mtfRsiLong1 ? 1 : 0) + (mtfRsiLong2 ? 1 : 0) + (mtfRsiLong3 ? 1 : 0) +
     (mtfVolOk1 ? 1 : 0) + (mtfVolOk2 ? 1 : 0) + (mtfVolOk3 ? 1 : 0)
mtfAlignedCountShort = (mtfTrendShort1 ? 1 : 0) + (mtfTrendShort2 ? 1 : 0) + (mtfTrendShort3 ? 1 : 0) +
     (mtfHullShort1 ? 1 : 0) + (mtfHullShort2 ? 1 : 0) + (mtfHullShort3 ? 1 : 0) +
     (mtfRsiShort1 ? 1 : 0) + (mtfRsiShort2 ? 1 : 0) + (mtfRsiShort3 ? 1 : 0) +
     (mtfVolOk1 ? 1 : 0) + (mtfVolOk2 ? 1 : 0) + (mtfVolOk3 ? 1 : 0)
mtfTotalChecks = 12.0
mtfAlignPctLong = (mtfAlignedCountLong / mtfTotalChecks) * 100.0
mtfAlignPctShort = (mtfAlignedCountShort / mtfTotalChecks) * 100.0
mtfAlignedLong = mtfAlignPctLong >= mtfAlignmentThresholdPct
mtfAlignedShort = mtfAlignPctShort >= mtfAlignmentThresholdPct
impulseLong = enableImpulseOverride and (close > open) and (math.abs(close - open) >= atr * impulseAtrMult) and (volume >= volumeMA * impulseVolumeMult)
impulseShort = enableImpulseOverride and (close < open) and (math.abs(close - open) >= atr * impulseAtrMult) and (volume >= volumeMA * impulseVolumeMult)
trendOverrideLong = enableTrendOverride and strongTrend and ema_bullish_aligned and hull_bullish
trendOverrideShort = enableTrendOverride and strongTrend and ema_bearish_aligned and hull_bearish
mtfFilterEnabled = mtfMode == "FILTER"
mtfFilterOKLong = (not mtfFilterEnabled) or mtfAlignedLong or impulseLong or trendOverrideLong
mtfFilterOKShort = (not mtfFilterEnabled) or mtfAlignedShort or impulseShort or trendOverrideShort
// ==============================
// 🛡️ COOPERATIVE STOPS + TPS
// ==============================
useCooperativeStops = input.bool(true, "Use Cooperative Stop System")
initialStopATR = input.float(1.2, "Initial Stop (ATR)", minval=0.8, maxval=2.0)
breakevenTriggerATR = input.float(1.5, "Breakeven Trigger (ATR)", minval=1.0, maxval=2.5)
trailingActivateATR = input.float(3.0, "Trailing Activation (ATR)", minval=2.0, maxval=4.0)
trailingDistanceATR = input.float(1.5, "Trailing Distance (ATR)", minval=1.0, maxval=2.5)
tp1_ATR = input.float(2.5, "TP1 (ATR)", minval=1.5, maxval=3.5)
tp1_Percent = input.int(70, "TP1 % of position", minval=50, maxval=80)
tp2_ATR = input.float(4.0, "TP2 (ATR)", minval=3.0, maxval=5.0)
tp2_Percent = input.int(25, "TP2 % of REMAINING (after TP1)", minval=15, maxval=35,
     tooltip="This percent is applied to what remains after TP1 (better for small contract counts).")
tp3_ATR = input.float(6.0, "TP3 (ATR)", minval=4.5, maxval=8.0)
// Stop placement cooperation: ATR + structure, with distance guardrails
stopStructureBufferATR = input.float(0.20, "Stop Buffer Beyond Swing (ATR)", minval=0.0, maxval=1.0,
     tooltip="Adds a buffer beyond the last swing pivot for structure-anchored stops.")
minStopDistanceATR = input.float(0.8, "Min Stop Distance (ATR)", minval=0.3, maxval=2.0,
     tooltip="Prevents ultra-tight stops that conflict with volatility.")
maxStopDistanceATR = input.float(2.5, "Max Stop Distance (ATR)", minval=1.0, maxval=5.0,
     tooltip="Prevents overly-wide stops that reduce trade quality.")
initialStopATR_eff = enableHighWinRateMode ? (initialStopATR * widerSlMultiplier) : initialStopATR
tp1_ATR_eff = enableHighWinRateMode ? (tp1_ATR * quickTpMultiplier) : tp1_ATR
tp2_ATR_eff = enableHighWinRateMode ? (tp2_ATR * quickTpMultiplier) : tp2_ATR
tp3_ATR_eff = enableHighWinRateMode ? (tp3_ATR * quickTpMultiplier) : tp3_ATR
// ==============================
// 📈 RISK + SIZING (VIRTUAL GUARDRAILS)
// ==============================
guardrailCapital = input.float(25000, "Guardrail Capital ($)", minval=5000, step=1000)
maxDailyLossPercent = input.float(2.0, "Max Daily Loss % (virtual guardrail)", minval=1.0, maxval=3.0)
maxDailyLossDollars = guardrailCapital * maxDailyLossPercent / 100.0
fixedContracts = input.int(1, "Fixed Contracts", minval=1, maxval=50)
// Institutional safety guards
maxConsecutiveLosses = input.int(2, "Max Consecutive Losing Trades (kill-switch)", minval=1, maxval=10,
     tooltip="Stops new entries after N losing trades until next session/day reset.")
cooldownAfterLossBars = input.int(30, "Cooldown Bars After Loss", minval=0, maxval=500,
     tooltip="Extra pause after a losing trade to avoid revenge trades.")
cooldownAfterWinBars = input.int(0, "Cooldown Bars After Win", minval=0, maxval=500)
maxHoldBars = input.int(0, "Max Hold Bars (0 = off)", minval=0, maxval=2000,
     tooltip="Time-stop: exits at market when a position has been open this many bars.")
exitOnReversal = input.bool(true, "Exit On Reversal Signal (institutional protection)")
reversalRequiresHullFlip = input.bool(true, "Reversal Requires Hull Flip")
reversalRequiresEma21Break = input.bool(true, "Reversal Requires EMA21 Break")
// ==============================
// 🏛️ INSTITUTIONAL RISK GUARDS
// ==============================
group_inst = "🏛️ Institutional Risk Guards"
enableInstRisk = input.bool(true, "Enable Institutional Risk Guards", group=group_inst)
maxDailyDrawdownPercent = input.float(1.5, "Max Intraday Drawdown % (peak->valley)", minval=0.2, maxval=5.0, group=group_inst)
flattenOnDrawdown = input.bool(false, "Flatten On Drawdown Kill (alert)", group=group_inst)
enableShockGuard = input.bool(true, "Volatility Shock Guard + Cooldown", group=group_inst)
shockRangeATR = input.float(2.8, "Shock Range (ATR)", minval=1.0, maxval=10.0, group=group_inst)
shockGapATR = input.float(2.5, "Shock Gap (ATR)", minval=1.0, maxval=10.0, group=group_inst)
shockCooldownBars = input.int(20, "Cooldown Bars After Shock", minval=0, maxval=500, group=group_inst)
flattenOnShock = input.bool(false, "Flatten On Shock (alert)", group=group_inst)
enableMaeExit = input.bool(false, "MAE Emergency Exit (ATR)", group=group_inst)
maeExitAtrMult = input.float(2.0, "MAE Exit Threshold (ATR)", minval=0.5, maxval=10.0, group=group_inst)
enableMaePctExit = input.bool(false, "MAE % Drawdown From Peak", group=group_inst)
maePctDrawdown = input.float(20.0, "MAE % Drawdown Threshold", minval=1.0, maxval=50.0, group=group_inst)
// ==============================
// 🏛️ INSTITUTIONAL TRAILING STOP
// ==============================
group_trail = "🏛️ Institutional Trailing Stop"
enableInstTrailing = input.bool(true, "Enable Institutional Trailing Stop", group=group_trail)
instTrailActivateATR = input.float(2.0, "Trail Activation (ATR)", minval=1.0, maxval=4.0, group=group_trail)
instTrailDistanceATR = input.float(1.2, "Trail Distance (ATR)", minval=0.5, maxval=3.0, group=group_trail)
instTrailMinStepTicks = input.int(2, "Min Trail Step (ticks)", minval=0, maxval=20, group=group_trail)
// ==============================
// 🛡️ ENTRY FILTERS + CONTROLS
// ==============================
group_entry = "🛡️ Entry Filters"
enableAdxFloor = input.bool(true, "ADX Floor Protection", group=group_entry)
adxFloorThreshold = input.float(20.0, "ADX Floor Threshold", minval=5.0, maxval=40.0, group=group_entry)
enableStopLossCooldown = input.bool(true, "Cooldown After Stop Loss", group=group_entry)
stopLossCooldownBars = input.int(10, "Stop Loss Cooldown Bars", minval=0, maxval=200, group=group_entry)
enableAtrPercentileGate = input.bool(true, "ATR Percentile Gate", group=group_entry)
atrPercentileLookback = input.int(100, "ATR Percentile Lookback", minval=20, maxval=300, group=group_entry)
atrPercentileMin = input.float(15.0, "ATR Percentile Min %", minval=0.0, maxval=50.0, group=group_entry)
atrPercentileMax = input.float(95.0, "ATR Percentile Max %", minval=50.0, maxval=100.0, group=group_entry)
enableTwoBarConfirm = input.bool(true, "Two-Bar Confirmation", group=group_entry)
enableEntryDedupe = input.bool(true, "Duplicate Entry Prevention", group=group_entry)
dedupeBars = input.int(3, "Dedupe Window (bars)", minval=1, maxval=20, group=group_entry)
enableGapProtection = input.bool(true, "Gap Protection", group=group_entry)
maxEntryGapPct = input.float(2.0, "Max Gap % From Prev Close", minval=0.5, maxval=10.0, group=group_entry)
enableRegimeFilter = input.bool(false, "Market Regime Filter", group=group_entry)
strongTrendPct = input.float(15.0, "Strong Trend %", minval=5.0, maxval=40.0, group=group_entry)
rangingTrendPct = input.float(8.0, "Ranging Trend %", minval=2.0, maxval=20.0, group=group_entry)
enableCandleDirection = input.bool(true, "Strict Candle Direction Control", group=group_entry)
minBodyAtrPct = input.float(0.2, "Min Candle Body % of ATR", minval=0.05, maxval=1.0, group=group_entry)
enableSlippageGuard = input.bool(true, "Slippage Protection", group=group_entry)
maxSlippageTicks = input.int(6, "Max Slippage (ticks)", minval=0, maxval=50, group=group_entry)
// ==============================
// 🧯 EXIT HIERARCHY (OPTION B)
// ==============================
group_exit = "🧯 Exit Hierarchy"
enableExitHierarchy = input.bool(true, "Enable Exit Hierarchy", group=group_exit)
maeProfitDrawdownPct = input.float(20.0, "MAE Drawdown % From Peak Profit", minval=5.0, maxval=50.0, group=group_exit)
maeMinBars = input.int(3, "MAE Min Bars In Trade", minval=0, maxval=50, group=group_exit)
highWrDrawdownMult = input.float(0.7, "High WR Drawdown Mult", minval=0.4, maxval=1.0, group=group_exit)
breakevenProfitDollars = input.float(40.0, "Breakeven Profit Trigger ($)", minval=0.0, maxval=500.0, group=group_exit)
breakevenAtrTrigger = input.float(1.5, "Breakeven Trigger (ATR)", minval=0.5, maxval=5.0, group=group_exit)
breakevenAtrHighWrMult = input.float(0.5, "High WR Breakeven ATR Mult", minval=0.2, maxval=1.0, group=group_exit)
breakevenFeeDollars = input.float(0.74, "Breakeven Fee Buffer ($)", minval=0.0, maxval=10.0, group=group_exit)
enableProfitLocks = input.bool(true, "Enable Profit Lock Stops", group=group_exit)
lock1Atr = input.float(2.0, "Lock Level 1 (ATR)", minval=0.5, maxval=5.0, group=group_exit)
lock1Pct = input.float(0.50, "Lock Level 1 %", minval=0.1, maxval=0.9, group=group_exit)
lock2Atr = input.float(3.5, "Lock Level 2 (ATR)", minval=1.0, maxval=8.0, group=group_exit)
lock2Pct = input.float(0.60, "Lock Level 2 %", minval=0.1, maxval=0.9, group=group_exit)
lock3Atr = input.float(5.0, "Lock Level 3 (ATR)", minval=1.0, maxval=10.0, group=group_exit)
lock3Pct = input.float(0.70, "Lock Level 3 %", minval=0.1, maxval=0.95, group=group_exit)
maxProfitDrawdownPct = input.float(20.0, "Max Profit Drawdown %", minval=5.0, maxval=80.0, group=group_exit)
timeProfitBars = input.int(15, "Time-Based Profit Bars", minval=1, maxval=500, group=group_exit)
timeProfitDrawdownAtr = input.float(0.5, "Time Profit Stall (ATR)", minval=0.1, maxval=3.0, group=group_exit)
losingTradePct = input.float(1.0, "Losing Trade Auto-Close %", minval=0.2, maxval=10.0, group=group_exit)
enableSignalReversalExit = input.bool(true, "Signal Reversal Exit", group=group_exit)
signalReversalBars = input.int(3, "Reversal Min Bars", minval=1, maxval=20, group=group_exit)
breakevenTriggerATR_eff = enableHighWinRateMode ? (breakevenTriggerATR * breakevenAtrHighWrMult) : breakevenTriggerATR
// ==============================
// 🔔 TRADERSPOST ALERT SETTINGS
// ==============================
enableStrategyOrders = input.bool(true, "Enable Strategy Orders (Backtest)")
enableAlerts = input.bool(true, "Enable TradersPost Alerts (Live)")
// Enforce a single execution mode to prevent conflicting exits.
executionMode = input.string("SCALE_OUT", "Live Execution Mode", options=["BRACKET_ONLY", "SCALE_OUT"],
     tooltip="BRACKET_ONLY sends ENTRY with stop+TP1 only. SCALE_OUT sends ENTRY plus TP/STOP exit alerts.")
emitExitAlertsInput = input.bool(true, "Emit TP/STOP Exit Alerts (advanced)")
includeBracketOnEntryInput = input.bool(true, "Include Stop + TP1 on Entry Alert (advanced)")
emitExitAlerts = executionMode == "SCALE_OUT" ? emitExitAlertsInput : false
includeBracketOnEntry = includeBracketOnEntryInput or (executionMode == "BRACKET_ONLY")
traderspostTicker = input.string("MGC1!", "TradersPost Ticker", tooltip="Sent in JSON. Map in TradersPost to your broker symbol.")
// Desync protection + idempotency
enableHeartbeat = input.bool(false, "Send Heartbeat/SYNC Alerts")
heartbeatEveryBars = input.int(12, "Heartbeat Every N Bars", minval=1, maxval=500,
     tooltip="Heartbeat JSON helps diagnose missed webhooks/desync. Keep this modest to avoid spam.")
// Emergency kill-switch (block entries, optionally flatten)
killSwitch = input.bool(false, "EMERGENCY KILL SWITCH (no new entries)")
flattenOnKill = input.bool(true, "Flatten On Kill Switch (send CLOSE alert)")
// ==============================
// 🧾 DAILY TRACKING (VIRTUAL)
// ==============================
var float dailyRealizedPnL = 0.0
var int dailyTrades = 0
var int lastTradeBar = 0
var int consecutiveLosses = 0
var int cooldownUntilBar = 0
newDay = ta.change(time("D")) != 0
if newDay
    dailyRealizedPnL := 0.0
    dailyPeakPnL := 0.0
    dailyTrades := 0
    lastTradeBar := 0
    consecutiveLosses := 0
    cooldownUntilBar := 0
    dailyDrawdownKilled := false
    lastShockBar := na
    lastEntryBarLong := na
    lastEntryBarShort := na
    lastStopBarLong := na
    lastStopBarShort := na
maxLossReached = dailyRealizedPnL < -maxDailyLossDollars
maxTradesReached = dailyTrades >= maxTradesPerDay
maxDailyDrawdownDollars = guardrailCapital * maxDailyDrawdownPercent / 100.0
dailyPeakPnL := math.max(dailyPeakPnL, dailyRealizedPnL)
dailyDrawdown = dailyPeakPnL - dailyRealizedPnL
drawdownHit = dailyDrawdown >= maxDailyDrawdownDollars
if enableInstRisk and drawdownHit
    dailyDrawdownKilled := true
drawdownKill = enableInstRisk and dailyDrawdownKilled
shockRange = high - low
shockGap = math.abs(close - close[1])
shockDetected = enableInstRisk and enableShockGuard and atr > 0 and ((shockRange > atr * shockRangeATR) or (shockGap > atr * shockGapATR))
if shockDetected
    lastShockBar := bar_index
inShockCooldown = enableInstRisk and enableShockGuard and not na(lastShockBar) and ((bar_index - lastShockBar) <= shockCooldownBars)
instRiskOK = (not enableInstRisk) or (not drawdownKill and not inShockCooldown)
// ==============================
// 📊 VIRTUAL POSITION STATE
// ==============================
var bool inPos = false
var bool isLong = false
var float entryPrice = na
var float currentStop = na
var bool tp1_hit = false
var bool tp2_hit = false
var bool breakeven_active = false
var bool trailing_active = false
var float qtyRemaining = 0.0
var float qtyOriginal = 0.0
var int entryBar = na
var int lastEntryBarLong = na
var int lastEntryBarShort = na
var int lastStopBarLong = na
var int lastStopBarShort = na
// MAE/MFE and per-trade realized PnL (virtual)
var float maePoints = 0.0
var float mfePoints = 0.0
var float tradeRealizedPnL = 0.0
var float lastTradeMAE = na
var float lastTradeMFE = na
var float lastTradePnL = na
var string lastExitReason = ""
var bool killSwitchPrev = false
var float atrAtEntry = na
var float dailyPeakPnL = 0.0
var bool dailyDrawdownKilled = false
var int lastShockBar = na
var bool instTrailActive = false
var float instTrailStop = na
var float lastInstTrailStop = na
var int lastInstExitBar = na
var bool instExitLatched = false
var float peakPriceSinceEntry = na
var float troughPriceSinceEntry = na
var float maeDrawdownPct = na
barsSinceLastTrade = bar_index - lastTradeBar
cooldownOK = bar_index >= cooldownUntilBar
lossStreakOK = consecutiveLosses < maxConsecutiveLosses
killOK = not killSwitch
// Use strategy position as source of truth for position state
inPos := strategy.position_size != 0
isLong := strategy.position_size > 0
qtyRemaining := inPos ? math.abs(strategy.position_size) : 0.0
canTrade = sessionFilterOK and timeWindowFilterOK and volatilityOK and killOK and instRiskOK and not maxLossReached and not maxTradesReached and (not inPos) and (barsSinceLastTrade >= minBarsBetweenTrades) and cooldownOK and lossStreakOK
adxFloorOK = (not enableAdxFloor) or adx >= adxFloorThreshold
atrPercentile = f_percent_rank(atr, atrPercentileLookback)
atrPercentileOK = (not enableAtrPercentileGate) or (not na(atrPercentile) and atrPercentile >= atrPercentileMin and atrPercentile <= atrPercentileMax)
twoBarUp = close > close[1] and close[1] > close[2]
twoBarDown = close < close[1] and close[1] < close[2]
twoBarOKLong = (not enableTwoBarConfirm) or twoBarUp
twoBarOKShort = (not enableTwoBarConfirm) or twoBarDown
gapPct = (not na(close[1]) and close[1] != 0) ? math.abs(open - close[1]) / close[1] * 100.0 : 0.0
gapOK = (not enableGapProtection) or gapPct <= maxEntryGapPct
slippageOK = (not enableSlippageGuard) or ((high - low) <= maxSlippageTicks * syminfo.mintick)
bodySize = math.abs(close - open)
bodyPctAtr = atr > 0 ? bodySize / atr : 0.0
candleDirLong = close > open and bodyPctAtr >= minBodyAtrPct
candleDirShort = close < open and bodyPctAtr >= minBodyAtrPct
candleOKLong = (not enableCandleDirection) or candleDirLong or impulseLong
candleOKShort = (not enableCandleDirection) or candleDirShort or impulseShort
dedupeOKLong = (not enableEntryDedupe) or na(lastEntryBarLong) or (bar_index - lastEntryBarLong > dedupeBars)
dedupeOKShort = (not enableEntryDedupe) or na(lastEntryBarShort) or (bar_index - lastEntryBarShort > dedupeBars)
stopCooldownOKLong = (not enableStopLossCooldown) or na(lastStopBarLong) or (bar_index - lastStopBarLong > stopLossCooldownBars)
stopCooldownOKShort = (not enableStopLossCooldown) or na(lastStopBarShort) or (bar_index - lastStopBarShort > stopLossCooldownBars)
trendStrengthPct = trendStrength * 100.0
regimeStrong = trendStrengthPct >= strongTrendPct
regimeRanging = trendStrengthPct < rangingTrendPct
marketRegimeOK = (not enableRegimeFilter) or (not regimeRanging)
// ==============================
// 🤝 COOPERATIVE SIGNAL QUALITY GATES
// ==============================
atrValid = atr > 0
entryCandidate = close
atrStopLong = entryCandidate - (atr * initialStopATR_eff)
atrStopShort = entryCandidate + (atr * initialStopATR_eff)
structStopLong = na(lastPivotLow) ? na : (lastPivotLow - (atr * stopStructureBufferATR))
structStopShort = na(lastPivotHigh) ? na : (lastPivotHigh + (atr * stopStructureBufferATR))
// For long: lower stop is "further away" (safer). For short: higher stop is "further away".
stopCandidateLong = na(structStopLong) ? atrStopLong : math.min(atrStopLong, structStopLong)
stopCandidateShort = na(structStopShort) ? atrStopShort : math.max(atrStopShort, structStopShort)
stopDistATRLong = atrValid ? math.abs(entryCandidate - stopCandidateLong) / atr : na
stopDistATRShort = atrValid ? math.abs(entryCandidate - stopCandidateShort) / atr : na
stopOKLong = atrValid and not na(stopDistATRLong) and stopDistATRLong >= minStopDistanceATR and stopDistATRLong <= maxStopDistanceATR
stopOKShort = atrValid and not na(stopDistATRShort) and stopDistATRShort >= minStopDistanceATR and stopDistATRShort <= maxStopDistanceATR
// Prevent mixed-direction “both good” situations; require directional dominance.
bothDirectionsHot = confluenceLong >= minConfluenceScore and confluenceShort >= minConfluenceScore
dominantLong = confluenceLong >= (confluenceShort + scoreDominance)
dominantShort = confluenceShort >= (confluenceLong + scoreDominance)
srOKLong = not avoidOpposingSR or not nearResistance
srOKShort = not avoidOpposingSR or not nearSupport
htfOKLong = not requireHtfAlignment or htf_bullish
htfOKShort = not requireHtfAlignment or htf_bearish
mtfOKLong = (not useMtfConfirmation) or mtf_bullish
mtfOKShort = (not useMtfConfirmation) or mtf_bearish
entryFiltersLong = (adxFloorOK and atrPercentileOK and twoBarOKLong and gapOK and slippageOK and candleOKLong and dedupeOKLong and stopCooldownOKLong and marketRegimeOK and confluenceLevelOKLong and mtfFilterOKLong) or impulseLong
entryFiltersShort = (adxFloorOK and atrPercentileOK and twoBarOKShort and gapOK and slippageOK and candleOKShort and dedupeOKShort and stopCooldownOKShort and marketRegimeOK and confluenceLevelOKShort and mtfFilterOKShort) or impulseShort
longSignal = canTrade and entryFiltersLong and stopOKLong and srOKLong and htfOKLong and mtfOKLong and (not bothDirectionsHot) and dominantLong and confluenceLong >= minConfluenceScore
shortSignal = canTrade and entryFiltersShort and stopOKShort and srOKShort and htfOKShort and mtfOKShort and (not bothDirectionsHot) and dominantShort and confluenceShort >= minConfluenceScore
// ==============================
// 🔧 JSON HELPERS
// ==============================
f_json_num(x) => str.tostring(x, "#.####")
f_signal_id(_kind, _side, _reason) =>
    // Uniqueness for idempotency: time + bar_index + kind/side/reason
    _kind + "-" + _side + "-" + _reason + "-" + str.tostring(time) + "-" + str.tostring(bar_index)
f_json_entry(_isLong, _qty, _stopPrice, _tp1Price, _score) =>
    action = _isLong ? "buy" : "sell"
    side = _isLong ? "LONG" : "SHORT"
    sid = f_signal_id("ENTRY", side, "ENTRY")
    base = '{"ticker":"' + traderspostTicker + '","action":"' + action + '","orderType":"market","quantity":' + str.tostring(_qty) + ',"confluenceScore":' + str.tostring(_score) + ',"signalId":"' + sid + '"'
    br = includeBracketOnEntry ? ',"stopLoss":{"stopPrice":' + f_json_num(_stopPrice) + '},"takeProfit":{"limitPrice":' + f_json_num(_tp1Price) + '}' : ""
    base + br + '}'
f_json_exit(_isLong, _qty, _reason, _refPrice) =>
    action = _isLong ? "sell" : "buy"
    side = _isLong ? "LONG" : "SHORT"
    sid = f_signal_id("EXIT", side, _reason)
    '{"ticker":"' + traderspostTicker + '","action":"' + action + '","orderType":"market","quantity":' + f_json_num(_qty) + ',"reduceOnly":true,"reason":"' + _reason + '","referencePrice":' + f_json_num(_refPrice) + ',"signalId":"' + sid + '"}'
f_json_heartbeat() =>
    // Diagnostic heartbeat (does not trade by itself unless your router interprets it)
    posSide = inPos ? (isLong ? "LONG" : "SHORT") : "FLAT"
    '{"ticker":"' + traderspostTicker + '","signal":"HEARTBEAT","positionModel":"' + posSide + '","qtyRemaining":' + f_json_num(qtyRemaining) + ',"cooldownActive":' + (bar_index < cooldownUntilBar ? "true" : "false") + ',"consecutiveLosses":' + str.tostring(consecutiveLosses) + ',"maxConsecutiveLosses":' + str.tostring(maxConsecutiveLosses) + ',"killSwitch":' + (killSwitch ? "true" : "false") + ',"time":' + str.tostring(time) + ',"barIndex":' + str.tostring(bar_index) + '}'
// ==============================
// 📍 ENTRY (ALERT + MODEL STATE)
// ==============================
// Kill-switch edge detection: optionally flatten immediately (one-shot per toggle)
killTriggered = killSwitch and not killSwitchPrev
killSwitchPrev := killSwitch
if barstate.isconfirmed and killTriggered and flattenOnKill and inPos and qtyRemaining > 0
    alert(f_json_exit(isLong, qtyRemaining, "KILL_SWITCH", close), alert.freq_once_per_bar_close)
    if enableStrategyOrders
        strategy.close_all(comment="KILL_SWITCH")
    // Treat as an exit for cooldown/loss tracking (virtual)
    pnlPoints = (close - entryPrice) * (isLong ? 1 : -1)
    pnlDollars = pnlPoints * syminfo.pointvalue * qtyRemaining
    dailyRealizedPnL += pnlDollars
    tradeRealizedPnL += pnlDollars
    lastTradePnL := tradeRealizedPnL
    lastTradeMAE := maePoints * syminfo.pointvalue * qtyOriginal
    lastTradeMFE := mfePoints * syminfo.pointvalue * qtyOriginal
    lastExitReason := "KILL_SWITCH"
    consecutiveLosses := tradeRealizedPnL < 0 ? (consecutiveLosses + 1) : 0
    cooldownUntilBar := bar_index + (tradeRealizedPnL < 0 ? cooldownAfterLossBars : cooldownAfterWinBars)
    lastTradeBar := bar_index
    inPos := false
    entryPrice := na
    currentStop := na
    tp1_hit := false
    tp2_hit := false
    breakeven_active := false
    trailing_active := false
    instTrailActive := false
    instTrailStop := na
    lastInstTrailStop := na
    instExitLatched := false
    peakPriceSinceEntry := na
    troughPriceSinceEntry := na
    qtyRemaining := 0.0
    qtyOriginal := 0.0
    entryBar := na
    maePoints := 0.0
    mfePoints := 0.0
    tradeRealizedPnL := 0.0
if barstate.isconfirmed
    // Strategy entries (backtest)
    if enableStrategyOrders and longSignal and fixedContracts > 0
        strategy.entry("Long", strategy.long, qty=fixedContracts, comment="Long score " + str.tostring(confluenceLong))
    if enableStrategyOrders and shortSignal and fixedContracts > 0
        strategy.entry("Short", strategy.short, qty=fixedContracts, comment="Short score " + str.tostring(confluenceShort))
    // Live alerts for entries (webhook)
    if enableAlerts
        if longSignal and fixedContracts > 0
            modeledEntry = close
            modeledStop = stopCandidateLong
            modeledTp1 = modeledEntry + (atr * tp1_ATR_eff)
            alert(f_json_entry(true, fixedContracts, modeledStop, modeledTp1, confluenceLong), alert.freq_once_per_bar_close)
        if shortSignal and fixedContracts > 0
            modeledEntry = close
            modeledStop = stopCandidateShort
            modeledTp1 = modeledEntry - (atr * tp1_ATR_eff)
            alert(f_json_entry(false, fixedContracts, modeledStop, modeledTp1, confluenceShort), alert.freq_once_per_bar_close)
    if longSignal and fixedContracts > 0
        lastEntryBarLong := bar_index
    if shortSignal and fixedContracts > 0
        lastEntryBarShort := bar_index
// Sync internal state to actual strategy position (entry/flat)
posOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
posClosed = strategy.position_size == 0 and strategy.position_size[1] != 0
if posOpened
    entryPrice := strategy.position_avg_price
    atrAtEntry := atr
    qtyOriginal := math.abs(strategy.position_size)
    qtyRemaining := qtyOriginal
    entryBar := bar_index
    maePoints := 0.0
    mfePoints := 0.0
    tradeRealizedPnL := 0.0
    tp1_hit := false
    tp2_hit := false
    breakeven_active := false
    trailing_active := false
    instTrailActive := false
    instTrailStop := na
    lastInstTrailStop := na
    instExitLatched := false
    peakPriceSinceEntry := high
    troughPriceSinceEntry := low
    // Initial cooperative stop from entry price
    atrStop = (strategy.position_size > 0) ? (entryPrice - (atrAtEntry * initialStopATR_eff)) : (entryPrice + (atrAtEntry * initialStopATR_eff))
    structStop = (strategy.position_size > 0) ? (na(lastPivotLow) ? na : (lastPivotLow - (atrAtEntry * stopStructureBufferATR))) : (na(lastPivotHigh) ? na : (lastPivotHigh + (atrAtEntry * stopStructureBufferATR)))
    currentStop := na(structStop) ? atrStop : ((strategy.position_size > 0) ? math.min(atrStop, structStop) : math.max(atrStop, structStop))
    dailyTrades += 1
if posClosed
    // enforce spacing from the exit
    lastTradeBar := bar_index
    entryPrice := na
    atrAtEntry := na
    currentStop := na
    qtyOriginal := 0.0
    qtyRemaining := 0.0
    entryBar := na
    tp1_hit := false
    tp2_hit := false
    breakeven_active := false
    trailing_active := false
    instTrailActive := false
    instTrailStop := na
    lastInstTrailStop := na
    peakPriceSinceEntry := na
    troughPriceSinceEntry := na
// ==============================
// 🫀 HEARTBEAT / SYNC (OPTIONAL)
// ==============================
if enableAlerts and barstate.isconfirmed and enableHeartbeat
    if (bar_index % heartbeatEveryBars) == 0
        alert(f_json_heartbeat(), alert.freq_once_per_bar_close)
// ==============================
// 📉 MAE/MFE TRACKING (INSTITUTIONAL METRICS)
// ==============================
if inPos and not na(entryPrice)
    // MAE: worst adverse move vs entry (negative points)
    // MFE: best favorable move vs entry (positive points)
    adverse = isLong ? (low - entryPrice) : (entryPrice - high)
    favorable = isLong ? (high - entryPrice) : (entryPrice - low)
    maePoints := math.min(maePoints, adverse)
    mfePoints := math.max(mfePoints, favorable)
    if isLong
        peakPriceSinceEntry := na(peakPriceSinceEntry) ? high : math.max(peakPriceSinceEntry, high)
        maeDrawdownPct := peakPriceSinceEntry > 0 ? ((peakPriceSinceEntry - close) / peakPriceSinceEntry) * 100.0 : na
    else
        troughPriceSinceEntry := na(troughPriceSinceEntry) ? low : math.min(troughPriceSinceEntry, low)
        maeDrawdownPct := troughPriceSinceEntry > 0 ? ((close - troughPriceSinceEntry) / troughPriceSinceEntry) * 100.0 : na
else
    maeDrawdownPct := na
barsInTrade = not na(entryBar) ? (bar_index - entryBar) : 0
currentProfitPts = inPos and not na(entryPrice) ? (isLong ? (close - entryPrice) : (entryPrice - close)) : 0.0
currentProfitDollars = currentProfitPts * syminfo.pointvalue * qtyRemaining
peakProfitPts = mfePoints
profitDrawdownPct = peakProfitPts > 0 ? math.max(((peakProfitPts - currentProfitPts) / peakProfitPts) * 100.0, 0.0) : 0.0
// ==============================
// 🏛️ INSTITUTIONAL EMERGENCY EXITS (ALERT + OPTIONAL CLOSE)
// ==============================
maeAtr = (not na(atrAtEntry) and atrAtEntry > 0) ? (math.abs(maePoints) / atrAtEntry) : na
instExitReason = ""
instExitTriggered = false
canInstExit = inPos and not na(entryPrice) and not instExitLatched and (na(lastInstExitBar) or lastInstExitBar != bar_index)
if canInstExit
    maeProfitDrawdownEff = enableHighWinRateMode ? (maeProfitDrawdownPct * highWrDrawdownMult) : maeProfitDrawdownPct
    maePctEffective = enableHighWinRateMode ? (maePctDrawdown * highWrDrawdownMult) : maePctDrawdown
    if enableExitHierarchy and (barsInTrade >= maeMinBars) and peakProfitPts > 0 and profitDrawdownPct >= maeProfitDrawdownEff
        instExitReason := "MAE_PROFIT"
        instExitTriggered := true
    else if enableExitHierarchy and peakProfitPts > 0 and (profitDrawdownPct >= maxProfitDrawdownPct)
        instExitReason := "MAX_DRAWDOWN"
        instExitTriggered := true
    else if enableExitHierarchy and not na(atrAtEntry) and (barsInTrade >= timeProfitBars) and (currentProfitPts > 0) and (peakProfitPts - currentProfitPts >= atrAtEntry * timeProfitDrawdownAtr)
        instExitReason := "TIME_PROTECT"
        instExitTriggered := true
    else if enableExitHierarchy and (entryPrice > 0) and ((currentProfitPts / entryPrice) * 100.0 <= -losingTradePct)
        instExitReason := "LOSS_CUT"
        instExitTriggered := true
    else if enableExitHierarchy and enableSignalReversalExit and (barsInTrade >= signalReversalBars) and ((isLong and dominantShort and confluenceShort >= minConfluenceScore) or (not isLong and dominantLong and confluenceLong >= minConfluenceScore))
        instExitReason := "REVERSAL"
        instExitTriggered := true
    else if enableInstRisk and drawdownKill and flattenOnDrawdown
        instExitReason := "DD_KILL"
        instExitTriggered := true
    else if enableInstRisk and enableShockGuard and flattenOnShock and shockDetected
        instExitReason := "VOL_SHOCK"
        instExitTriggered := true
    else if enableMaeExit and not na(maeAtr) and maeAtr >= maeExitAtrMult
        instExitReason := "MAE"
        instExitTriggered := true
    else if enableMaePctExit and not na(maeDrawdownPct) and maeDrawdownPct >= maePctEffective
        instExitReason := "MAE_PCT"
        instExitTriggered := true
if instExitTriggered
    if enableAlerts
        alert(f_json_exit(isLong, qtyRemaining, instExitReason, close), alert.freq_once_per_bar_close)
    if enableStrategyOrders
        strategy.close_all(comment=instExitReason)
    pnlPoints = (close - entryPrice) * (isLong ? 1 : -1)
    pnlDollars = pnlPoints * syminfo.pointvalue * qtyRemaining
    dailyRealizedPnL += pnlDollars
    tradeRealizedPnL += pnlDollars
    lastTradePnL := tradeRealizedPnL
    lastTradeMAE := maePoints * syminfo.pointvalue * qtyOriginal
    lastTradeMFE := mfePoints * syminfo.pointvalue * qtyOriginal
    lastExitReason := instExitReason
    consecutiveLosses := tradeRealizedPnL < 0 ? (consecutiveLosses + 1) : 0
    cooldownUntilBar := bar_index + (tradeRealizedPnL < 0 ? cooldownAfterLossBars : cooldownAfterWinBars)
    lastTradeBar := bar_index
    lastInstExitBar := bar_index
    instExitLatched := true
    inPos := false
    entryPrice := na
    currentStop := na
    tp1_hit := false
    tp2_hit := false
    breakeven_active := false
    trailing_active := false
    instTrailActive := false
    instTrailStop := na
    lastInstTrailStop := na
    peakPriceSinceEntry := na
    troughPriceSinceEntry := na
    qtyRemaining := 0.0
    qtyOriginal := 0.0
    entryBar := na
    maePoints := 0.0
    mfePoints := 0.0
    tradeRealizedPnL := 0.0
// ==============================
// 🛡️ COOPERATIVE STOP MANAGEMENT (MODEL)
// ==============================
if useCooperativeStops and inPos and not na(entryPrice)
    currentProfit = isLong ? (close - entryPrice) : (entryPrice - close)
    if not breakeven_active and currentProfit >= atr * breakevenTriggerATR_eff
        breakeven_active := true
        beStop = isLong ? (entryPrice + (2 * syminfo.mintick)) : (entryPrice - (2 * syminfo.mintick))
        currentStop := isLong ? math.max(currentStop, beStop) : math.min(currentStop, beStop)
    if not trailing_active and currentProfit >= atr * trailingActivateATR
        trailing_active := true
    if trailing_active
        trailStop = isLong ? (close - (atr * trailingDistanceATR)) : (close + (atr * trailingDistanceATR))
        currentStop := isLong ? math.max(currentStop, trailStop) : math.min(currentStop, trailStop)
// ==============================
// 🧯 EXIT HIERARCHY: BREAKEVEN + PROFIT LOCKS
// ==============================
if enableExitHierarchy and inPos and not na(entryPrice) and not na(atrAtEntry)
    beAtrTrigger = enableHighWinRateMode ? (breakevenAtrTrigger * breakevenAtrHighWrMult) : breakevenAtrTrigger
    beHit = (currentProfitPts >= atrAtEntry * beAtrTrigger) or (breakevenProfitDollars > 0 and currentProfitDollars >= breakevenProfitDollars)
    feeBufferPts = syminfo.pointvalue != 0 ? (breakevenFeeDollars / syminfo.pointvalue) : 0.0
    beStopPrice = isLong ? (entryPrice + feeBufferPts) : (entryPrice - feeBufferPts)
    if beHit
        currentStop := isLong ? math.max(currentStop, beStopPrice) : math.min(currentStop, beStopPrice)
    if enableProfitLocks
        lockPct = na
        if currentProfitPts >= atrAtEntry * lock3Atr
            lockPct := lock3Pct
        else if currentProfitPts >= atrAtEntry * lock2Atr
            lockPct := lock2Pct
        else if currentProfitPts >= atrAtEntry * lock1Atr
            lockPct := lock1Pct
        if not na(lockPct)
            lockStop = isLong ? (entryPrice + (currentProfitPts * lockPct)) : (entryPrice - (currentProfitPts * lockPct))
            currentStop := isLong ? math.max(currentStop, lockStop) : math.min(currentStop, lockStop)
// ==============================
// 🏛️ INSTITUTIONAL TRAILING STOP (MODEL)
// ==============================
if enableInstTrailing and inPos and not na(entryPrice) and not na(atrAtEntry)
    instProfit = isLong ? (close - entryPrice) : (entryPrice - close)
    if not instTrailActive and instProfit >= (atrAtEntry * instTrailActivateATR)
        instTrailActive := true
    if instTrailActive
        instCandidate = isLong ? (close - (atrAtEntry * instTrailDistanceATR)) : (close + (atrAtEntry * instTrailDistanceATR))
        stepTicks = instTrailMinStepTicks * syminfo.mintick
        improved = na(lastInstTrailStop) ? true : (isLong ? (instCandidate > lastInstTrailStop + stepTicks) : (instCandidate < lastInstTrailStop - stepTicks))
        if improved
            instTrailStop := instCandidate
            lastInstTrailStop := instCandidate
        if not na(instTrailStop)
            currentStop := isLong ? math.max(currentStop, instTrailStop) : math.min(currentStop, instTrailStop)
// ==============================
// 🎯 EXITS (TP1/TP2/TP3 + STOP) — ALERT ONLY
// ==============================
// Use entry ATR for fixed targets (more stable)
tp1_price = inPos and not na(entryPrice) ? (isLong ? entryPrice + (atrAtEntry * tp1_ATR_eff) : entryPrice - (atrAtEntry * tp1_ATR_eff)) : na
tp2_price = inPos and not na(entryPrice) ? (isLong ? entryPrice + (atrAtEntry * tp2_ATR_eff) : entryPrice - (atrAtEntry * tp2_ATR_eff)) : na
tp3_price = inPos and not na(entryPrice) ? (isLong ? entryPrice + (atrAtEntry * tp3_ATR_eff) : entryPrice - (atrAtEntry * tp3_ATR_eff)) : na
// Strategy exits (backtest)
if enableStrategyOrders and inPos and not na(entryPrice) and barstate.isconfirmed
    // Convert TP2 percent-of-remaining into absolute percent of original position.
    tp1_abs = tp1_Percent
    tp2_abs = (100 - tp1_Percent) * (tp2_Percent / 100.0)
    tp3_abs = 100.0 - tp1_abs - tp2_abs
    if executionMode == "BRACKET_ONLY"
        if isLong
            strategy.exit("Bracket_Long", "Long", limit=tp1_price, stop=currentStop, comment="Bracket")
        else
            strategy.exit("Bracket_Short", "Short", limit=tp1_price, stop=currentStop, comment="Bracket")
    else
        if isLong
            strategy.exit("TP1_Long", "Long", qty_percent=tp1_abs, limit=tp1_price, stop=currentStop, comment="TP1")
            strategy.exit("TP2_Long", "Long", qty_percent=tp2_abs, limit=tp2_price, stop=currentStop, comment="TP2")
            strategy.exit("TP3_Long", "Long", qty_percent=tp3_abs, limit=tp3_price, stop=currentStop, comment="TP3")
        else
            strategy.exit("TP1_Short", "Short", qty_percent=tp1_abs, limit=tp1_price, stop=currentStop, comment="TP1")
            strategy.exit("TP2_Short", "Short", qty_percent=tp2_abs, limit=tp2_price, stop=currentStop, comment="TP2")
            strategy.exit("TP3_Short", "Short", qty_percent=tp3_abs, limit=tp3_price, stop=currentStop, comment="TP3")
// Live exit alerts (webhook)
if enableAlerts and emitExitAlerts and inPos and not na(entryPrice) and qtyRemaining > 0 and barstate.isconfirmed
    tp1Touched = isLong ? (high >= tp1_price) : (low <= tp1_price)
    tp2Touched = isLong ? (high >= tp2_price) : (low <= tp2_price)
    tp3Touched = isLong ? (high >= tp3_price) : (low <= tp3_price)
    stopTouched = isLong ? (low <= currentStop) : (high >= currentStop)
    // Reversal protection (close position at market on strong opposite regime)
    oppDominant = isLong ?
         (confluenceShort >= minConfluenceScore and confluenceShort >= (confluenceLong + scoreDominance) and (not requireHtfAlignment or htf_bearish) and ((not useMtfConfirmation) or mtf_bearish)) :
         (confluenceLong >= minConfluenceScore and confluenceLong >= (confluenceShort + scoreDominance) and (not requireHtfAlignment or htf_bullish) and ((not useMtfConfirmation) or mtf_bullish))
    hullFlipOK = not reversalRequiresHullFlip or (isLong ? hull_bearish : hull_bullish)
    ema21BreakOK = not reversalRequiresEma21Break or (isLong ? close < ema21 : close > ema21)
    reversalTouched = exitOnReversal and oppDominant and hullFlipOK and ema21BreakOK
    // Time-stop (optional)
    holdBars = not na(entryBar) ? (bar_index - entryBar) : 0
    timeStopTouched = (maxHoldBars > 0) and (holdBars >= maxHoldBars)
    // Priority: STOP first (conservative for same-bar TP/STOP conflicts)
    if stopTouched
        alert(f_json_exit(isLong, qtyRemaining, "STOP", currentStop), alert.freq_once_per_bar_close)
        // virtual realized PnL
        pnlPoints = (currentStop - entryPrice) * (isLong ? 1 : -1)
        pnlDollars = pnlPoints * syminfo.pointvalue * qtyRemaining
        dailyRealizedPnL += pnlDollars
        tradeRealizedPnL += pnlDollars
        if isLong
            lastStopBarLong := bar_index
        else
            lastStopBarShort := bar_index
        // finalize trade stats / risk state
        lastTradePnL := tradeRealizedPnL
        lastTradeMAE := maePoints * syminfo.pointvalue * qtyOriginal
        lastTradeMFE := mfePoints * syminfo.pointvalue * qtyOriginal
        lastExitReason := "STOP"
        consecutiveLosses := tradeRealizedPnL < 0 ? (consecutiveLosses + 1) : 0
        cooldownUntilBar := bar_index + (tradeRealizedPnL < 0 ? cooldownAfterLossBars : cooldownAfterWinBars)
        lastTradeBar := bar_index
        // reset model
        inPos := false
        entryPrice := na
        currentStop := na
        tp1_hit := false
        tp2_hit := false
        breakeven_active := false
        trailing_active := false
        instTrailActive := false
        instTrailStop := na
        lastInstTrailStop := na
        peakPriceSinceEntry := na
        troughPriceSinceEntry := na
        qtyRemaining := 0.0
        qtyOriginal := 0.0
        entryBar := na
        maePoints := 0.0
        mfePoints := 0.0
        tradeRealizedPnL := 0.0
    else
        // Reversal / time-stop exits (market)
        if reversalTouched or timeStopTouched
            reason = reversalTouched ? "REVERSAL" : "TIME"
            alert(f_json_exit(isLong, qtyRemaining, reason, close), alert.freq_once_per_bar_close)
            pnlPoints = (close - entryPrice) * (isLong ? 1 : -1)
            pnlDollars = pnlPoints * syminfo.pointvalue * qtyRemaining
            dailyRealizedPnL += pnlDollars
            tradeRealizedPnL += pnlDollars
            lastTradePnL := tradeRealizedPnL
            lastTradeMAE := maePoints * syminfo.pointvalue * qtyOriginal
            lastTradeMFE := mfePoints * syminfo.pointvalue * qtyOriginal
            lastExitReason := reason
            consecutiveLosses := tradeRealizedPnL < 0 ? (consecutiveLosses + 1) : 0
            cooldownUntilBar := bar_index + (tradeRealizedPnL < 0 ? cooldownAfterLossBars : cooldownAfterWinBars)
            lastTradeBar := bar_index
            inPos := false
            entryPrice := na
            currentStop := na
            tp1_hit := false
            tp2_hit := false
            breakeven_active := false
            trailing_active := false
            instTrailActive := false
            instTrailStop := na
            lastInstTrailStop := na
            peakPriceSinceEntry := na
            troughPriceSinceEntry := na
            qtyRemaining := 0.0
            qtyOriginal := 0.0
            entryBar := na
            maePoints := 0.0
            mfePoints := 0.0
            tradeRealizedPnL := 0.0
        else
            // Determine the highest TP stage reached this bar
            stage = tp3Touched ? 3 : tp2Touched ? 2 : tp1Touched ? 1 : 0
            // Contract allocation:
            // - TP1 is % of ORIGINAL
            // - TP2 is % of REMAINING after TP1 (works better for small contract counts)
            tp1_qty_target = math.round(qtyOriginal * (tp1_Percent / 100.0))
            tp1_qty_target := math.min(tp1_qty_target, qtyOriginal)
            remaining_after_tp1 = math.max(qtyOriginal - tp1_qty_target, 0)
            tp2_qty_target = math.round(remaining_after_tp1 * (tp2_Percent / 100.0))
            tp2_qty_target := math.min(tp2_qty_target, remaining_after_tp1)
            tp3_qty_target = math.max(qtyOriginal - tp1_qty_target - tp2_qty_target, 0)
            // Fire the missing exits needed to "catch up" to the stage.
            if stage >= 1 and not tp1_hit and tp1_qty_target > 0 and qtyRemaining > 0
                qtyOut = math.min(tp1_qty_target, qtyRemaining)
                alert(f_json_exit(isLong, qtyOut, "TP1", tp1_price), alert.freq_once_per_bar_close)
                pnlPoints = (tp1_price - entryPrice) * (isLong ? 1 : -1)
                pnlDollars = pnlPoints * syminfo.pointvalue * qtyOut
                dailyRealizedPnL += pnlDollars
                tradeRealizedPnL += pnlDollars
                qtyRemaining -= qtyOut
                tp1_hit := true
            if stage >= 2 and tp1_hit and not tp2_hit and tp2_qty_target > 0 and qtyRemaining > 0
                qtyOut = math.min(tp2_qty_target, qtyRemaining)
                alert(f_json_exit(isLong, qtyOut, "TP2", tp2_price), alert.freq_once_per_bar_close)
                pnlPoints = (tp2_price - entryPrice) * (isLong ? 1 : -1)
                pnlDollars = pnlPoints * syminfo.pointvalue * qtyOut
                dailyRealizedPnL += pnlDollars
                tradeRealizedPnL += pnlDollars
                qtyRemaining -= qtyOut
                tp2_hit := true
            if stage >= 3 and tp2_hit and qtyRemaining > 0
                alert(f_json_exit(isLong, qtyRemaining, "TP3", tp3_price), alert.freq_once_per_bar_close)
                pnlPoints = (tp3_price - entryPrice) * (isLong ? 1 : -1)
                pnlDollars = pnlPoints * syminfo.pointvalue * qtyRemaining
                dailyRealizedPnL += pnlDollars
                tradeRealizedPnL += pnlDollars
                lastTradePnL := tradeRealizedPnL
                lastTradeMAE := maePoints * syminfo.pointvalue * qtyOriginal
                lastTradeMFE := mfePoints * syminfo.pointvalue * qtyOriginal
                lastExitReason := "TP3"
                consecutiveLosses := tradeRealizedPnL < 0 ? (consecutiveLosses + 1) : 0
                cooldownUntilBar := bar_index + (tradeRealizedPnL < 0 ? cooldownAfterLossBars : cooldownAfterWinBars)
                lastTradeBar := bar_index
                // reset model
                inPos := false
                entryPrice := na
                currentStop := na
                tp1_hit := false
                tp2_hit := false
                breakeven_active := false
                trailing_active := false
                instTrailActive := false
                instTrailStop := na
                lastInstTrailStop := na
                peakPriceSinceEntry := na
                troughPriceSinceEntry := na
                qtyRemaining := 0.0
                qtyOriginal := 0.0
                entryBar := na
                maePoints := 0.0
                mfePoints := 0.0
                tradeRealizedPnL := 0.0
            // safety reset if fully scaled out
            if inPos and qtyRemaining <= 0
                lastTradePnL := tradeRealizedPnL
                lastTradeMAE := maePoints * syminfo.pointvalue * qtyOriginal
                lastTradeMFE := mfePoints * syminfo.pointvalue * qtyOriginal
                lastExitReason := "SCALED_OUT"
                consecutiveLosses := tradeRealizedPnL < 0 ? (consecutiveLosses + 1) : 0
                cooldownUntilBar := bar_index + (tradeRealizedPnL < 0 ? cooldownAfterLossBars : cooldownAfterWinBars)
                lastTradeBar := bar_index
                inPos := false
                entryPrice := na
                currentStop := na
                tp1_hit := false
                tp2_hit := false
                breakeven_active := false
                trailing_active := false
                instTrailActive := false
                instTrailStop := na
                lastInstTrailStop := na
                peakPriceSinceEntry := na
                troughPriceSinceEntry := na
                qtyRemaining := 0.0
                qtyOriginal := 0.0
                entryBar := na
                maePoints := 0.0
                mfePoints := 0.0
                tradeRealizedPnL := 0.0
// ==============================
// 📊 DISPLAYS
// ==============================
var table perfTable = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 85))
if barstate.isfirst
    // Pine tables don't support `colspan` in table.cell(); use merge instead.
    table.merge_cells(perfTable, 0, 0, 1, 0)
if barstate.isconfirmed
    table.cell(perfTable, 0, 0, "MGC ALERT-ONLY", bgcolor=color.new(color.gold, 60), text_color=color.white)
    table.cell(perfTable, 0, 1, "Daily Trades", text_color=color.white)
    table.cell(perfTable, 1, 1, str.tostring(dailyTrades) + "/" + str.tostring(maxTradesPerDay), text_color=maxTradesReached ? color.orange : color.lime)
    table.cell(perfTable, 0, 2, "Daily P&L (virtual)", text_color=color.white)
    table.cell(perfTable, 1, 2, "$" + str.tostring(dailyRealizedPnL, "#.##"), text_color=dailyRealizedPnL >= 0 ? color.lime : color.red)
    table.cell(perfTable, 0, 3, "Confluence", text_color=color.white)
    table.cell(perfTable, 1, 3, str.tostring(math.max(confluenceLong, confluenceShort)) + "/10", text_color=color.white)
    table.cell(perfTable, 0, 4, "ADX", text_color=color.white)
    table.cell(perfTable, 1, 4, str.tostring(adx, "#.#"), text_color=adx >= adxThreshold ? color.lime : color.gray)
    table.cell(perfTable, 0, 5, "Session", text_color=color.white)
    table.cell(perfTable, 1, 5, sessionFilterOK ? "OK" : "OFF", text_color=sessionFilterOK ? color.lime : color.red)
    table.cell(perfTable, 0, 6, "Position", text_color=color.white)
    table.cell(perfTable, 1, 6, inPos ? (isLong ? "LONG" : "SHORT") : "FLAT", text_color=inPos ? color.yellow : color.gray)
    table.cell(perfTable, 0, 7, "Stop Mode", text_color=color.white)
    table.cell(perfTable, 1, 7, inPos ? (breakeven_active ? "BE" : trailing_active ? "TRAIL" : "INIT") : "-", text_color=color.aqua)
    table.cell(perfTable, 0, 8, "Qty Rem", text_color=color.white)
    table.cell(perfTable, 1, 8, inPos ? str.tostring(qtyRemaining) : "0", text_color=color.white)
    table.cell(perfTable, 0, 9, "Loss Streak", text_color=color.white)
    table.cell(perfTable, 1, 9, str.tostring(consecutiveLosses) + "/" + str.tostring(maxConsecutiveLosses), text_color=consecutiveLosses >= maxConsecutiveLosses ? color.red : color.lime)
    table.cell(perfTable, 0, 10, "Cooldown", text_color=color.white)
    cdText = bar_index < cooldownUntilBar ? "ON" : "OFF"
    table.cell(perfTable, 1, 10, cdText, text_color=bar_index < cooldownUntilBar ? color.orange : color.lime)
    table.cell(perfTable, 0, 11, "Last Exit", text_color=color.white)
    table.cell(perfTable, 1, 11, lastExitReason, text_color=color.white)
    table.cell(perfTable, 0, 12, "Last PnL (virt)", text_color=color.white)
    table.cell(perfTable, 1, 12, na(lastTradePnL) ? "-" : ("$" + str.tostring(lastTradePnL, "#.##")), text_color=na(lastTradePnL) ? color.gray : (lastTradePnL >= 0 ? color.lime : color.red))
// ==============================
// 📈 VISUAL PLOTS
// ==============================
plot(ema9, "EMA 9", color=color.new(color.red, 50), linewidth=1)
plot(ema21, "EMA 21", color=color.new(color.orange, 50), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.blue, 50), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.purple, 50), linewidth=2)
plot(hull, "Hull MA", color=hull_bullish ? color.green : hull_bearish ? color.red : color.gray, linewidth=3)
plot(inPos ? currentStop : na, "Stop (model)", color=breakeven_active ? color.yellow : trailing_active ? color.aqua : color.red, linewidth=2, style=plot.style_cross)
plot(showExtraIndicators ? upperEnv : na, "Envelope Upper", color=color.new(color.orange, 30), linewidth=1)
plot(showExtraIndicators ? lowerEnv : na, "Envelope Lower", color=color.new(color.orange, 30), linewidth=1)
plot(showExtraIndicators ? superTrendLine : na, "SuperTrend", color=superTrendDir == 1 ? color.lime : color.red, linewidth=2)
plotshape(longSignal, "Long Signal", shape.triangleup, location.belowbar, color=color.green, size=size.tiny, text="L " + str.tostring(confluenceLong))
plotshape(shortSignal, "Short Signal", shape.triangledown, location.abovebar, color=color.red, size=size.tiny, text="S " + str.tostring(confluenceShort))
bgcolor(not sessionFilterOK ? color.new(color.red, 92) : na)
bgcolor(maxLossReached ? color.new(color.red, 88) : na)
bgcolor(maxTradesReached ? color.new(color.orange, 92) : na)
