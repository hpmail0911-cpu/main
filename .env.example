# ── AI API Keys ───────────────────────────────────────────────────────────────
# Groq (Llama) — used by ai_chart_scanner.py for AI-powered signal scanning
GROQ_API_KEY=

# OpenAI (GPT-4o-mini) — used by llama_analyzer_openai.py for Tier-1 validation
OPENAI_API_KEY=

# ── TradersPost Webhooks ─────────────────────────────────────────────────────
# Order entry webhook for all trades & instruments
TRADERSPOST_WEBHOOK=

# ── ProjectX / TopStepX Credentials ──────────────────────────────────────────
# ProjectX login — used by data_feed.py for live futures data
PROJECTX_USERNAME=
PROJECTX_PASSWORD=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=

# ── TopStepX Account ─────────────────────────────────────────────────────────
TOPSTEPX_USERNAME=
TOPSTEPX_PASSWORD=

# ── Local Ollama Configuration (optional fallback if no OpenAI key) ──────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./topstepx_trades.db
