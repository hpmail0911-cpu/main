hullSrc = input.source(close, "Hull Source")
baseHullMain = input.int(12, "Base Hull MA (Main)", minval=5, maxval=40)
baseHullFast = input.int(7, "Base Hull MA (Fast)", minval=5, maxval=15)
baseHullSignal = input.int(14, "Base Hull MA (Signal)", minval=8, maxval=22)
hullPeriodMain = isMNQ ? math.round(baseHullMain * 1.2) : isMES ? math.round(baseHullMain * 0.75) : isMCL ? math.round(baseHullMain * 0.85) : isMGC ? baseHullMain : isM2K ? math.round(baseHullMain * 0.8) : baseHullMain
hullPeriodFast = isMNQ ? baseHullFast : isMES ? math.round(baseHullFast * 0.85) : isMCL ? math.round(baseHullFast * 0.9) : isMGC ? baseHullFast : isM2K ? math.round(baseHullFast * 0.9) : baseHullFast
hullPeriodSignal = isMNQ ? baseHullSignal : isMES ? math.round(baseHullSignal * 0.85) : isMCL ? math.round(baseHullSignal * 0.9) : isMGC ? baseHullSignal : isM2K ? math.round(baseHullSignal * 0.9) : baseHullSignal
baseEnvLength = input.int(12, "Base Envelope Period", minval=8, maxval=20)
baseEnvDev = input.float(0.8, "Base Envelope Deviation %", minval=0.5, maxval=1.5)
envLength = isMNQ ? math.round(baseEnvLength * 1.0) : isMES ? math.round(baseEnvLength * 1.0) : isMCL ? baseEnvLength : isMGC ? math.round(baseEnvLength * 1.1) : isM2K ? math.round(baseEnvLength * 1.05) : baseEnvLength
envDev = isMNQ ? baseEnvDev * 1.0 : isMES ? baseEnvDev * 1.0 : isMCL ? baseEnvDev * 1.0 : isMGC ? baseEnvDev * 0.95 : isM2K ? baseEnvDev * 1.05 : baseEnvDev
basePivotPeriod = input.int(2, "Base Pivot Period", minval=1, maxval=4)
baseAtrFactor = input.float(2.2, "Base ATR Factor", minval=1.8, maxval=3.0)
baseAtrPeriod = input.int(8, "Base ATR Period", minval=6, maxval=12)
pivotPeriod = basePivotPeriod
atrFactor = isMNQ ? baseAtrFactor * 1.1 : isMES ? baseAtrFactor * 1.1 : isMCL ? baseAtrFactor * 1.05 : isMGC ? baseAtrFactor : isM2K ? baseAtrFactor * 1.15 : baseAtrFactor
atrPeriod = isMNQ ? math.round(baseAtrPeriod * 1.0) : isMES ? math.round(baseAtrPeriod * 1.0) : isMCL ? baseAtrPeriod : isMGC ? math.round(baseAtrPeriod * 1.1) : isM2K ? math.round(baseAtrPeriod * 1.05) : baseAtrPeriod
baseRiskPercent = input.float(0.6, "Base Risk per Trade (%)", minval=0.2, maxval=2.0)
instrumentRiskMultiplier = isMNQ ? 1.1 : isMES ? 1.1 : isMCL ? 1.0 : isMGC ? 1.0 : isM2K ? 1.05 : 1.0
adjustedRiskPercent = baseRiskPercent * instrumentRiskMultiplier
useTP = input.bool(true, "Use Take Profit Levels")
useSL = input.bool(true, "Use Stop Loss")
