            if curProfitPts >= beTriggerPts
                stopNow := math.min(stopNow, localEntryPrice - kenyaBEOffsetPts)
            [stopOkS_kenyaSingle, stopValS_kenyaSingle, stopCrossedS_kenyaSingle] = stopCheckShort(stopNow)
            if useTP and useSL
                if stopOkS_kenyaSingle
                    strategy.exit("KENYA_SINGLE_S", from_entry="SHORT", qty_percent=100, profit=targetTicks, stop=stopValS_kenyaSingle)
                else if stopCrossedS_kenyaSingle and not exitIssuedThisBar
                    strategy.close("SHORT", comment="KENYA_STOP_CROSSED")
                    exitIssuedThisBar := true
                    lastExitReason := "KENYA_STOP_CROSSED"
            else if useTP
                strategy.exit("KENYA_SINGLE_S", from_entry="SHORT", qty_percent=100, profit=targetTicks)
            else if useSL
                if stopOkS_kenyaSingle
                    strategy.exit("KENYA_SINGLE_S", from_entry="SHORT", qty_percent=100, stop=stopValS_kenyaSingle)
                else if stopCrossedS_kenyaSingle and not exitIssuedThisBar
                    strategy.close("SHORT", comment="KENYA_STOP_CROSSED")
                    exitIssuedThisBar := true
                    lastExitReason := "KENYA_STOP_CROSSED"
        else
            tp1Ticks = math.round(currentTP1 / syminfo.mintick)
            tp2Ticks = math.round(currentTP2 / syminfo.mintick)
            tp3Ticks = math.round(currentTP3 / syminfo.mintick)
            tp4Ticks = math.round(currentTP4 / syminfo.mintick)
            if useTP
                strategy.exit("KENYA_TP1_S", from_entry="SHORT", qty_percent=60, profit=tp1Ticks)
                strategy.exit("KENYA_TP2_S", from_entry="SHORT", qty_percent=25, profit=tp2Ticks)
                strategy.exit("KENYA_TP3_S", from_entry="SHORT", qty_percent=10, profit=tp3Ticks)
                strategy.exit("KENYA_TP4_S", from_entry="SHORT", qty_percent=5, profit=tp4Ticks)
            if useSL
                [stopOkS_kenyaLadder, stopValS_kenyaLadder, stopCrossedS_kenyaLadder] = stopCheckShort(localStopLoss)
                if stopOkS_kenyaLadder
                    strategy.exit("KENYA_SL_S", from_entry="SHORT", stop=stopValS_kenyaLadder)
                else if stopCrossedS_kenyaLadder and not exitIssuedThisBar
                    strategy.close("SHORT", comment="KENYA_STOP_CROSSED")
                    exitIssuedThisBar := true
                    lastExitReason := "KENYA_STOP_CROSSED"
    else
        currentProfitPts = localEntryPrice - close
        if currentProfitPts > 0
            v71_profitBarsCount := v71_profitBarsCount + 1
        else
            v71_profitBarsCount := 0
        if currentProfitPts > v71_maxProfitSeen
            v71_maxProfitSeen := currentProfitPts
        if not tp1Hit and low <= localEntryPrice - currentTP1
            tp1Hit := true
        float beOffsetPoints = 0.0
        if beAfterTP1UseFees
            oneWayFees = commissionPerContract + extraFeesPerContract
            roundTripFees = oneWayFees * 2
            slipPts = slippageTicksOneWay * syminfo.mintick
            beOffsetPoints := (roundTripFees / safePointValue) + slipPts
        localStopLoss = localEntryPrice + currentSL
        localBEStop = localEntryPrice - beOffsetPoints
        v71_trailingActivationLevel = currentTP1 * (trailingActivationPct / 100.0)
        if enableAdaptiveTrailing and currentProfitPts >= v71_trailingActivationLevel
            v71_trailingActive := true
            v71_newTrailingStop = localEntryPrice - v71_maxProfitSeen * (1.0 - trailingStepPct / 100.0)
            if na(v71_trailingStop) or v71_newTrailingStop < v71_trailingStop
                v71_trailingStop := v71_newTrailingStop
        v71_profitLockLevel = currentTP1 * (profitLockMinPct / 100.0)
        if enableTimeProfitLock and v71_profitBarsCount >= profitLockBars and currentProfitPts >= v71_profitLockLevel
            v71_profitLockActive := true
            v71_lockedProfitLevel := localEntryPrice - currentProfitPts * (profitLockKeepPct / 100.0)
        float v71_bestStop = localStopLoss
        if (enableBEAfterTP1 or (highWinRateMode and isMnqWinTF)) and tp1Hit
            v71_bestStop := localBEStop
        if v71_trailingActive and not na(v71_trailingStop) and v71_trailingStop < v71_bestStop
            v71_bestStop := v71_trailingStop
        if v71_profitLockActive and not na(v71_lockedProfitLevel) and v71_lockedProfitLevel < v71_bestStop
            v71_bestStop := v71_lockedProfitLevel
        float activeStop = v71_bestStop
        tp1Ticks = math.round(currentTP1 / syminfo.mintick)
        tp2Ticks = math.round(currentTP2 / syminfo.mintick)
        tp3Ticks = math.round(currentTP3 / syminfo.mintick)
        tp4Ticks = math.round(currentTP4 / syminfo.mintick)
        v71_quickScalpLevel = currentTP1 * (quickScalpProfitPct / 100.0)
        v71_quickScalpTicks = math.round(v71_quickScalpLevel / syminfo.mintick)
        bool v71_useQuickScalp = enableQuickScalpExit and holdingPeriod <= quickScalpBars and highWinRateMode
        if math.abs(strategy.position_size) == 1
            bool useMnq3mBooster = enableMnq3mWinRateBooster_eff and isMNQ and is3m_chart and highWinRateMode
            float boosterTargetPts = currentTP1 * mnq3mBoosterTargetPctOfTP1
            int boosterTargetTicks = math.round(boosterTargetPts / syminfo.mintick)
            float beOffsetPts = 0.0
            if mnq3mBoosterUseFeesForBE
                oneWayFees = commissionPerContract + extraFeesPerContract
                roundTripFees = oneWayFees * 2
                slipPts = slippageTicksOneWay * syminfo.mintick
                beOffsetPts := (roundTripFees / safePointValue) + slipPts
            bool useMes3mBooster = enableMes3mWinRateBooster_eff and isMes3m and highWinRateMode
            float mesTargetPts = currentTP1 * mes3mBoosterTargetPctOfTP1
            int mesTargetTicks = math.round(mesTargetPts / syminfo.mintick)
            bool useMes5mBooster = enableMes5mWinRateBooster_eff and isMes5m and highWinRateMode
            float mes5mTargetPts = math.min(currentTP1, currentSL * mes5mTargetSLMult)
            int mes5mTargetTicks = math.round(mes5mTargetPts / syminfo.mintick)
            float boosterBEStop = localEntryPrice - beOffsetPts
            float boosterBETriggerPts = boosterTargetPts * mnq3mBoosterBETriggerPctOfTarget
            float boosterStop = (currentProfitPts >= boosterBETriggerPts) ? math.min(activeStop, boosterBEStop) : activeStop
            float mesBEOffsetPts = 0.0
            if mes3mBoosterUseFeesForBE
                oneWayFees2 = commissionPerContract + extraFeesPerContract
                roundTripFees2 = oneWayFees2 * 2
                slipPts2 = slippageTicksOneWay * syminfo.mintick
                mesBEOffsetPts := (roundTripFees2 / safePointValue) + slipPts2
            float mesBEStop = localEntryPrice - mesBEOffsetPts
            float mesBETriggerPts = mesTargetPts * mes3mBoosterBETriggerPctOfTarget
            float mesStop = (currentProfitPts >= mesBETriggerPts) ? math.min(activeStop, mesBEStop) : activeStop
            float mes5mBEOffsetPts = 0.0
            if mes5mUseFeesForBE
                oneWayFees3 = commissionPerContract + extraFeesPerContract
                roundTripFees3 = oneWayFees3 * 2
                slipPts3 = slippageTicksOneWay * syminfo.mintick
                mes5mBEOffsetPts := (roundTripFees3 / safePointValue) + slipPts3
            float mes5mBEStop = localEntryPrice - mes5mBEOffsetPts
            float mes5mBETriggerPts = mes5mTargetPts * mes5mBETriggerPctOfTarget
            float mes5mStop = (currentProfitPts >= mes5mBETriggerPts) ? math.min(activeStop, mes5mBEStop) : activeStop
            int baseSingleTargetTicks = v71_useQuickScalp ? v71_quickScalpTicks : ((highWinRateMode and (isMnqWinTF or isMES)) ? tp1Ticks : tp2Ticks)
            targetTicks = useMnq3mBooster ? boosterTargetTicks : useMes3mBooster ? mesTargetTicks : useMes5mBooster ? mes5mTargetTicks : baseSingleTargetTicks
            float finalStop = useMnq3mBooster ? boosterStop : useMes3mBooster ? mesStop : useMes5mBooster ? mes5mStop : activeStop
            [stopOkS_v71Single, stopValS_v71Single, stopCrossedS_v71Single] = stopCheckShort(finalStop)
            if useTP and useSL
                if stopOkS_v71Single
                    strategy.exit("V71_TP_SINGLE_S", from_entry="SHORT", qty_percent=100, profit=targetTicks, stop=stopValS_v71Single)
                else if stopCrossedS_v71Single and not exitIssuedThisBar
                    strategy.close("SHORT", comment="V71_STOP_CROSSED")
                    exitIssuedThisBar := true
                    lastExitReason := "V71_STOP_CROSSED"
            else if useTP
                strategy.exit("V71_TP_SINGLE_S", from_entry="SHORT", qty_percent=100, profit=targetTicks)
            else if useSL
                if stopOkS_v71Single
                    strategy.exit("V71_SL_SINGLE_S", from_entry="SHORT", qty_percent=100, stop=stopValS_v71Single)
                else if stopCrossedS_v71Single and not exitIssuedThisBar
                    strategy.close("SHORT", comment="V71_STOP_CROSSED")
                    exitIssuedThisBar := true
                    lastExitReason := "V71_STOP_CROSSED"
        else
            if useTP
                strategy.exit("V71_TP1_S", from_entry="SHORT", qty_percent=60, profit=tp1Ticks)
                strategy.exit("V71_TP2_S", from_entry="SHORT", qty_percent=25, profit=tp2Ticks)
                strategy.exit("V71_TP3_S", from_entry="SHORT", qty_percent=10, profit=tp3Ticks)
                strategy.exit("V71_TP4_S", from_entry="SHORT", qty_percent=5, profit=tp4Ticks)
            if useSL
                [stopOkS_v71Multi, stopValS_v71Multi, stopCrossedS_v71Multi] = stopCheckShort(activeStop)
                if stopOkS_v71Multi
                    strategy.exit("V71_SL_S", from_entry="SHORT", stop=stopValS_v71Multi)
                else if stopCrossedS_v71Multi and not exitIssuedThisBar
                    strategy.close("SHORT", comment="V71_STOP_CROSSED")
                    exitIssuedThisBar := true
                    lastExitReason := "V71_STOP_CROSSED"
getBackupSL() =>
    isMES ? backupSL_MES : isMNQ ? backupSL_MNQ : backupSL_Default
if enableBackupSL and strategy.position_size != 0 and not na(entryPrice) and not mesMJV6Active
    backupSLDistance = getBackupSL()
    if strategy.position_size > 0
        backupStopLevel = entryPrice - backupSLDistance
        if close <= backupStopLevel and not exitIssuedThisBar and currentProfitDollars < 0
            strategy.close("LONG", comment="BACKUP_SL")
            exitIssuedThisBar := true
            lastExitReason := "BACKUP_SL"
    else if strategy.position_size < 0
        backupStopLevel = entryPrice + backupSLDistance
        if close >= backupStopLevel and not exitIssuedThisBar and currentProfitDollars < 0
            strategy.close("SHORT", comment="BACKUP_SL")
            exitIssuedThisBar := true
            lastExitReason := "BACKUP_SL"
if enableNuclearExit and strategy.position_size != 0 and holdingPeriod >= nuclearMaxBars and not exitIssuedThisBar
    strategy.close_all(comment="NUCLEAR_EXIT")
    exitIssuedThisBar := true
    lastExitReason := "NUCLEAR_EXIT"
v71_rsiNow = rsi
v71_rsiPrev = rsi[momentumFadeBars]
v71_inProfit = strategy.position_size > 0 ? (close > entryPrice) : strategy.position_size < 0 ? (close < entryPrice) : false
if enableMomentumFadeExit and strategy.position_size != 0 and v71_inProfit and holdingPeriod >= momentumFadeBars and not mesMJV6Active and not mjv6UltraActive and not runnerActive
    if strategy.position_size > 0
        if v71_rsiNow < v71_rsiPrev - momentumFadeThreshold and v71_rsiNow < 50
            if not exitIssuedThisBar
                strategy.close("LONG", comment="V71_MOM_FADE")
                exitIssuedThisBar := true
                lastExitReason := "V71_MOM_FADE"
    else if strategy.position_size < 0
        if v71_rsiNow > v71_rsiPrev + momentumFadeThreshold and v71_rsiNow > 50
            if not exitIssuedThisBar
                strategy.close("SHORT", comment="V71_MOM_FADE")
                exitIssuedThisBar := true
                lastExitReason := "V71_MOM_FADE"
strongOpposingBuy = (impulseLong or hasMomentumOverrideLong) and candleBull and not isDojiBar
strongOpposingSell = (impulseShort or hasMomentumOverrideShort) and candleBear and not isDojiBar
kenyaActiveNow = kenyaEnableSignalReversal and isMNQ and ((timeframe.period == "3" and useKenyaMnq3mProfitLogic) or (timeframe.period == "5" and useKenyaMnq5mProfitLogic))
if (useSignalReversalExits or kenyaActiveNow) and strategy.position_size != 0 and holdingPeriod >= minBarsBeforeSignalReversal and not mesMJV6Active and not mjv6UltraActive
    if strategy.position_size > 0 and strongOpposingSell
        if not exitIssuedThisBar
            strategy.close("LONG", comment="SIGNAL_REVERSAL_STRONG")
            exitIssuedThisBar := true
            lastExitReason := "SIGNAL_REVERSAL"
    else if strategy.position_size < 0 and strongOpposingBuy
        if not exitIssuedThisBar
            strategy.close("SHORT", comment="SIGNAL_REVERSAL_STRONG")
            exitIssuedThisBar := true
            lastExitReason := "SIGNAL_REVERSAL"
if useEndOfDayExits and strategy.position_size != 0 and eodWindowStart and not exitIssuedThisBar and not mesMJV6Active
    strategy.close_all(comment="EOD_EXIT")
    exitIssuedThisBar := true
    lastExitReason := "EOD_EXIT"
mnqIs3m = isMNQ and is3min
mnqIs5m = isMNQ and is5min
qtyForGuards = math.max(originalQty, 1)
mnqHardStopDol = mnqIs3m ? mnqHardStopDol_3m : mnqIs5m ? mnqHardStopDol_5m : na
mnqRedStopBars = mnqIs3m ? mnqRedTimeStopBars_3m : mnqIs5m ? mnqRedTimeStopBars_5m : na
mnqQuickBars = mnqIs3m ? mnqQuickExitBars_3m : mnqIs5m ? mnqQuickExitBars_5m : na
mnqQuickLossDol = mnqIs3m ? mnqQuickExitLossDol_3m : mnqIs5m ? mnqQuickExitLossDol_5m : na
mnqMaeActivateDol = mnqIs3m ? mnqMAEActivateDol_3m : mnqIs5m ? mnqMAEActivateDol_5m : na
tpExitWebhook(reason) =>
    dirStr = strategy.position_size > 0 ? "LONG" : "SHORT"
    exitSigIdLocal = str.tostring(time) + "_" + str.tostring(bar_index) + "_exit_" + dirStr
    tradeIdLocal = (tpTradeId != "" ? tpTradeId : (str.tostring(time) + "_" + str.tostring(bar_index)))
    '{' +
     '"ticker":"' + actualTicker + '",' +
     '"action":"exit",' +
     '"quantity":' + tpNumInt(int(math.abs(strategy.position_size))) + ',' +
     '"price":' + tpNum(close) + ',' +
     '"reason":"' + reason + '",' +
     '"trade_id":"' + tradeIdLocal + '",' +
     '"entry_signal_id":"' + tradeIdLocal + '",' +
     '"instance":"' + tpInstTag + '",' +
     '"strategy":"' + tpStrategyName + '",' +
     '"timeframe":"' + timeframe.period + '",' +
     '"instrument":"' + instrumentName + '",' +
     '"signal_id":"' + exitSigIdLocal + '",' +
     '"timestamp":"' + str.tostring(time) + '"' +
     '}'
topstepExitNow = topstepExitGuard and (isMNQ or isMES) and strategy.position_size != 0 and (currentTimeCT >= topstepExitTimeCT)
if topstepExitNow and not exitIssuedThisBar
    strategy.close_all(comment="TOPSTEP_RTH_EXIT")
    exitIssuedThisBar := true
    lastExitReason := "TOPSTEP_RTH_EXIT"
    if enableTradersPostAlerts_eff and not tookTradeThisBar
        alert(tpExitWebhook("topstep_rth_exit"), alert.freq_once_per_bar)
        exitAlertSentThisBar := true
        tookTradeThisBar := true
mnqRiskGuardsActive = not (mjv6UltraActive and isMNQ)
if isMNQ and (mnqIs3m or mnqIs5m) and strategy.position_size != 0 and not exitIssuedThisBar and not mesMJV6Active and mnqRiskGuardsActive
    if enablePerTradeHardStop and not na(mnqHardStopDol) and currentProfitDollars <= -(mnqHardStopDol * qtyForGuards)
        strategy.close_all(comment="HARD_STOP")
        exitIssuedThisBar := true
        lastExitReason := "HARD_STOP"
        if enableTradersPostAlerts_eff and not tookTradeThisBar
            alert(tpExitWebhook("hard_stop"), alert.freq_once_per_bar)
            exitAlertSentThisBar := true
            tookTradeThisBar := true
    if enableQuickExitRed and not exitIssuedThisBar and not na(mnqQuickBars) and holdingPeriod >= mnqQuickBars and not na(mnqQuickLossDol) and currentProfitDollars <= -(mnqQuickLossDol * qtyForGuards)
        strategy.close_all(comment="QUICK_EXIT_RED")
        exitIssuedThisBar := true
        lastExitReason := "QUICK_EXIT_RED"
        if enableTradersPostAlerts_eff and not tookTradeThisBar
            alert(tpExitWebhook("quick_exit_red"), alert.freq_once_per_bar)
            exitAlertSentThisBar := true
            tookTradeThisBar := true
    if enableRedTimeStop and not exitIssuedThisBar and not na(mnqRedStopBars) and holdingPeriod >= mnqRedStopBars and currentProfitDollars < 0
        strategy.close_all(comment="TIME_STOP_RED")
        exitIssuedThisBar := true
        lastExitReason := "TIME_STOP_RED"
        if enableTradersPostAlerts_eff and not tookTradeThisBar
            alert(tpExitWebhook("time_stop_red"), alert.freq_once_per_bar)
            exitAlertSentThisBar := true
            tookTradeThisBar := true
    if enableMAEProtection and not exitIssuedThisBar and not na(mnqMaeActivateDol) and peakProfit >= (mnqMaeActivateDol * qtyForGuards) and currentProfitDollars <= (peakProfit * maeDrawbackPercent)
        strategy.close_all(comment="MAE_PROTECT")
        exitIssuedThisBar := true
        lastExitReason := "MAE_PROTECT"
        if enableTradersPostAlerts_eff and not tookTradeThisBar
            alert(tpExitWebhook("mae_protection"), alert.freq_once_per_bar)
            exitAlertSentThisBar := true
            tookTradeThisBar := true
mesIs3m = isMES and is3min
mesIs5m = isMES and is5min
mesHardStopDol = mesIs3m ? mesFixedSLDol_3m : mesIs5m ? mesFixedSLDol_5m : na
if isMES and (mesIs3m or mesIs5m) and strategy.position_size != 0 and not exitIssuedThisBar and not mesMJV6Active
    if enablePerTradeHardStop and not na(mesHardStopDol) and currentProfitDollars <= -(mesHardStopDol * qtyForGuards)
        strategy.close_all(comment="HARD_STOP")
        exitIssuedThisBar := true
        lastExitReason := "HARD_STOP"
        if enableTradersPostAlerts_eff and not tookTradeThisBar
            alert(tpExitWebhook("hard_stop"), alert.freq_once_per_bar)
            exitAlertSentThisBar := true
            tookTradeThisBar := true
if useLosingTradeAutoClose and strategy.position_size != 0 and not na(entryPrice) and not mesMJV6Active and not mjv6UltraActive
    lossThresholdDollars = (strategy.equity * losingTradeThreshold / 100)
    if math.abs(currentProfitDollars) >= lossThresholdDollars and currentProfitDollars < 0 and not exitIssuedThisBar
        strategy.close_all(comment="LOSING_AUTO")
        exitIssuedThisBar := true
        lastExitReason := "LOSING_AUTO"
if enableMaxHoldExit and strategy.position_size != 0 and holdingPeriod >= maxHoldBars and not exitIssuedThisBar and not mesMJV6Active and not mjv6UltraActive and not runnerActive
    strategy.close_all(comment="MAX_HOLD")
    exitIssuedThisBar := true
    lastExitReason := "MAX_HOLD"
f_traderspostAlerts(_tpTradeId, _tookTrade) =>
    tradeIdLocal = _tpTradeId
    tookLocal = _tookTrade
    exitAlertSentLocal = false
    tpUseSim = false
    tpFlat = (strategy.position_size == 0)
    tpJustEnteredLong = (strategy.position_size > 0 and strategy.position_size[1] == 0)
    tpJustEnteredShort = (strategy.position_size < 0 and strategy.position_size[1] == 0)
    tpCanEnterLong = tpFlat or tpJustEnteredLong
    tpCanEnterShort = tpFlat or tpJustEnteredShort
    tpLong = (strategy.position_size > 0)
    tpShort = (strategy.position_size < 0)
    tpQty = int(math.abs(strategy.position_size))
    tpAlertFreq = entryTimingMode_eff == "Bar Close" ? alert.freq_once_per_bar_close : alert.freq_once_per_bar
    tpSigType = activeSignalType
    tpSelPrio = selectedPriority
    tpConfluence = totalConfluenceScore
    tpMtfAlignPct = mtf_alignment_pct
    tpFiveStarOK = fiveStarOK
    tpChoppy = isChoppy
    tpCandleDir = candleBullStrict ? "GREEN" : candleBearStrict ? "RED" : "NEUTRAL"
    tpExecPrice = close
    tpSignalPrice = close
    tpEntryQty = finalContractQty
    tpSession =
         isLondonSession ? "LONDON" :
         isNYSession ? "NY" :
         isAsianSession ? "ASIAN" :
         isUAESession ? "UAE" : "OTHER"
    if tpExitOnReverseSignal and enableTradersPostAlerts_eff and entryOK and not tpFlat and not tookLocal
        if (entrySignalLongForAlert and tpShort) or (entrySignalShortForAlert and tpLong)
            exitDir = tpShort ? "SHORT" : tpLong ? "LONG" : "FLAT"
            exitQty = tpQty
            exitSigId = tpSignalId("exit", exitDir)
            exitPrice = close
            exitNowMessage = '{' +
                 '"ticker":"' + actualTicker + '",' +
                 '"action":"exit",' +
                 '"quantity":' + tpNumInt(exitQty) + ',' +
                 '"price":' + tpNum(exitPrice) + ',' +
                 '"reason":"reverse_signal",' +
                 '"trade_id":"' + tradeIdLocal + '",' +
                 '"entry_signal_id":"' + tradeIdLocal + '",' +
                 '"instance":"' + tpInstTag + '",' +
                 '"strategy":"' + tpStrategyName + '",' +
                 '"timeframe":"' + timeframe.period + '",' +
                 '"instrument":"' + instrumentName + '",' +
                 '"signal_id":"' + exitSigId + '",' +
                 '"timestamp":"' + str.tostring(time) + '"' +
                 '}'
            if exitQty > 0
                alert(exitNowMessage, alert.freq_once_per_bar)
                exitAlertSentLocal := true
                tookLocal := true
    if entryOK and entrySignalLongForAlert and tpCanEnterLong and allowEntryLong and tpEntryQty > 0 and enableTradersPostAlerts_eff
        bool is3m_chart = timeframe.period == "3"
        bool useMnq3m = isMNQ and is3m_chart and mnq_useCustom3m
        float currentSL_pts = isMES ? mesSL_pts : (useMnq3m ? mnq_customSL_3m : mnq_customSL)
        float currentTP1_pts = isMES ? mesTP_pts : (useMnq3m ? mnq_customTP1_3m : mnq_customTP1)
        if useManualDollarOverrides and manualDollarSL > 0
            currentSL_pts := manualDollarSL / safePointValue
        if useManualDollarOverrides and manualDollarTP > 0
            currentTP1_pts := manualDollarTP / safePointValue
        localSL = tpExecPrice - currentSL_pts
        localTP1 = tpExecPrice + currentTP1_pts
        slDol = useManualDollarOverrides and manualDollarSL > 0 ? manualDollarSL : (currentSL_pts * safePointValue)
        tpDol = useManualDollarOverrides and manualDollarTP > 0 ? manualDollarTP : (currentTP1_pts * safePointValue)
        entrySigId = tpSignalId("buy", "LONG")
        tradeIdLocal := entrySigId
        longEntryMessage = '{' +
             '"ticker":"' + actualTicker + '",' +
             '"action":"buy",' +
             '"quantity":' + tpNumInt(tpEntryQty) + ',' +
             '"price":' + tpNum(tpExecPrice) + ',' +
             '"orderType":"limit",' +
             '"limit":' + tpNum(tpExecPrice) + ',' +
             '"takeProfit":{"limitPrice":' + tpNum(localTP1) + '},' +
             '"stopLoss":{"stopPrice":' + tpNum(localSL) + '},' +
             '"trade_id":"' + tradeIdLocal + '",' +
             '"instance":"' + tpInstTag + '",' +
             '"strategy":"' + tpStrategyName + '",' +
             '"timeframe":"' + timeframe.period + '",' +
             '"instrument":"' + instrumentName + '",' +
             '"signal_id":"' + entrySigId + '",' +
             '"timestamp":"' + str.tostring(time) + '"' +
             '}'
        alert(longEntryMessage, tpAlertFreq)
    if entryOK and entrySignalShortForAlert and tpCanEnterShort and allowEntryShort and tpEntryQty > 0 and enableTradersPostAlerts_eff
        bool is3m_chart = timeframe.period == "3"
        bool useMnq3m = isMNQ and is3m_chart and mnq_useCustom3m
        float currentSL_pts = isMES ? mesSL_pts : (useMnq3m ? mnq_customSL_3m : mnq_customSL)
        float currentTP1_pts = isMES ? mesTP_pts : (useMnq3m ? mnq_customTP1_3m : mnq_customTP1)
        if useManualDollarOverrides and manualDollarSL > 0
            currentSL_pts := manualDollarSL / safePointValue
        if useManualDollarOverrides and manualDollarTP > 0
            currentTP1_pts := manualDollarTP / safePointValue
        localSL = tpExecPrice + currentSL_pts
        localTP1 = tpExecPrice - currentTP1_pts
        slDol = useManualDollarOverrides and manualDollarSL > 0 ? manualDollarSL : (currentSL_pts * safePointValue)
        tpDol = useManualDollarOverrides and manualDollarTP > 0 ? manualDollarTP : (currentTP1_pts * safePointValue)
        entrySigId = tpSignalId("sell", "SHORT")
        tradeIdLocal := entrySigId
        shortEntryMessage = '{' +
             '"ticker":"' + actualTicker + '",' +
             '"action":"sell",' +
             '"quantity":' + tpNumInt(tpEntryQty) + ',' +
             '"price":' + tpNum(tpExecPrice) + ',' +
             '"orderType":"limit",' +
             '"limit":' + tpNum(tpExecPrice) + ',' +
             '"takeProfit":{"limitPrice":' + tpNum(localTP1) + '},' +
             '"stopLoss":{"stopPrice":' + tpNum(localSL) + '},' +
             '"trade_id":"' + tradeIdLocal + '",' +
             '"instance":"' + tpInstTag + '",' +
             '"strategy":"' + tpStrategyName + '",' +
             '"timeframe":"' + timeframe.period + '",' +
             '"instrument":"' + instrumentName + '",' +
             '"signal_id":"' + entrySigId + '",' +
             '"timestamp":"' + str.tostring(time) + '"' +
             '}'
        alert(shortEntryMessage, tpAlertFreq)
    if tpSendEODExitAlert and useEndOfDayExits and eodWindowStart and enableTradersPostAlerts_eff and strategy.position_size != 0 and not tookLocal
        exitSigId = tpSignalId("exit", strategy.position_size > 0 ? "LONG" : "SHORT")
        exitPrice = close
        eodExitMessage = '{' +
             '"ticker":"' + actualTicker + '",' +
             '"action":"exit",' +
             '"quantity":' + tpNumInt(int(math.abs(strategy.position_size))) + ',' +
             '"price":' + tpNum(exitPrice) + ',' +
             '"reason":"eod_exit",' +
             '"trade_id":"' + tradeIdLocal + '",' +
             '"entry_signal_id":"' + tradeIdLocal + '",' +
             '"instance":"' + tpInstTag + '",' +
             '"strategy":"' + tpStrategyName + '",' +
             '"timeframe":"' + timeframe.period + '",' +
             '"instrument":"' + instrumentName + '",' +
             '"signal_id":"' + exitSigId + '",' +
             '"timestamp":"' + str.tostring(time) + '"' +
             '}'
        alert(eodExitMessage, alert.freq_once_per_bar)
        exitAlertSentLocal := true
        tookLocal := true
    [tradeIdLocal, tookLocal, exitAlertSentLocal]
[newTradeIdTmp, newTookTmp, newExitAlertTmp] = f_traderspostAlerts(tpTradeId, tookTradeThisBar)
tpTradeId := newTradeIdTmp
tookTradeThisBar := newTookTmp
exitAlertSentThisBar := exitAlertSentThisBar or newExitAlertTmp
if enableTradersPostAlerts_eff and exitIssuedThisBar and not exitAlertSentThisBar and not tookTradeThisBar
    fallbackReason = lastExitReason != "NONE" ? lastExitReason : "exit"
    alert(tpExitWebhook(fallbackReason), alert.freq_once_per_bar)
    exitAlertSentThisBar := true
    tookTradeThisBar := true
