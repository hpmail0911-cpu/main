conf_strongVolume = volume > volumeMA * 1.2 ? 1 : 0
conf_momentum = (momentumBull or momentumBear) ? 1 : 0
conf_strongMom = (strongMomentumBull or strongMomentumBear) ? 1 : 0
conf_trend = (strongTrend or moderateTrend) ? 1 : 0
conf_priceAction = (priceUp or priceDown) ? 1 : 0
conf_atrExpanding = star_atrExpanding ? 1 : 0
totalConfluenceScore = conf_volume + conf_strongVolume + conf_momentum + conf_strongMom + conf_trend + conf_priceAction + conf_atrExpanding
effConfluenceLevel = (isMES and enableMesAntiChop) ? math.min(confluenceLevel + mesConfluenceBoost, 15) : confluenceLevel
requiredConfluence =
     effConfluenceLevel <= 2 ? 1 :
     effConfluenceLevel <= 4 ? 2 :
     effConfluenceLevel <= 6 ? 3 :
     effConfluenceLevel <= 8 ? 4 :
     effConfluenceLevel <= 10 ? 5 :
     effConfluenceLevel <= 12 ? 6 : 7
finalConfluenceOK = totalConfluenceScore >= requiredConfluence
bodyStrong = (not requireBodyStrength) or (atr10 > 0 and bodySize >= atr10 * minBodyPctOfATR) or (enableFilterHarmony and candleQualityOK)
longBarOK = bodyStrong and candleBullStrict
shortBarOK = bodyStrong and candleBearStrict
confirmGroup = "✅ Candle Confirm (Auto-tuned)"
autoTuneGenericConfirm = input.bool(true, "Auto-tune generic candle confirm (MNQ/MES 3m/5m)", group=confirmGroup)
genConfirmBodyRatioInput = input.float(0.45, "Generic confirm: min body ratio (manual)", minval=0.20, maxval=0.80, step=0.01, group=confirmGroup)
genConfirmAtrMultInput = input.float(0.25, "Generic confirm: min body (×ATR10) (manual)", minval=0.05, maxval=0.60, step=0.01, group=confirmGroup)
genConfirmBodyRatio_eff =
     (not autoTuneGenericConfirm) ? genConfirmBodyRatioInput :
     isMNQ_3m ? 0.28 :
     isMNQ_5m ? 0.26 :
     isMES_3m ? 0.30 :
     isMES_5m ? 0.32 :
     genConfirmBodyRatioInput
genConfirmAtrMult_eff =
     (not autoTuneGenericConfirm) ? genConfirmAtrMultInput :
     isMNQ_3m ? 0.10 :
     isMNQ_5m ? 0.10 :
     isMES_3m ? 0.12 :
     isMES_5m ? 0.12 :
     genConfirmAtrMultInput
genericBullConfirm = candleBull and bodyRatio >= genConfirmBodyRatio_eff and (atr10 <= 0 or bodySize >= atr10 * genConfirmAtrMult_eff)
genericBearConfirm = candleBear and bodyRatio >= genConfirmBodyRatio_eff and (atr10 <= 0 or bodySize >= atr10 * genConfirmAtrMult_eff)
