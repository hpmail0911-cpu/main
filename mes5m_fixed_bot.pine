tradersPostSymbolMES = input.string("MESH2026", "TradersPost Symbol - MES (Update contract month!)")
tradersPostSymbolM2K = input.string("M2KH2026", "TradersPost Symbol - M2K (Update contract month!)")
tradersPostSymbolMCL = input.string("MCLH2026", "TradersPost Symbol - MCL (Update contract month!)")
tradersPostSymbolMGC = input.string("MGCH2026", "TradersPost Symbol - MGC (Update contract month!)")
