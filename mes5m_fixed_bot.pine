        strategy.exit("V20_TP2_L", from_entry="LONG", qty_percent=25, profit=tp2Points)
        strategy.exit("V20_TP3_L", from_entry="LONG", qty_percent=10, profit=tp3Points)
        strategy.exit("V20_TP4_L", from_entry="LONG", qty_percent=5, profit=tp4Points)
