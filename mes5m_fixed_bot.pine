baseTfMultiplier2h = input.float(0.7, "Base 2h TF Multiplier", minval=0.4, maxval=1.0)
baseTfMultiplier4h = input.float(0.6, "Base 4h TF Multiplier", minval=0.3, maxval=0.8)
currentTF = timeframe.period
is1min = currentTF == "1" or currentTF == "1m"
is2min = currentTF == "2" or currentTF == "2m"
is3min = currentTF == "3" or currentTF == "3m"
is5min = currentTF == "5" or currentTF == "5m"
is10min = currentTF == "10" or currentTF == "10m"
is15min = currentTF == "15" or currentTF == "15m"
is30min = currentTF == "30" or currentTF == "30m"
is1hour = currentTF == "60" or currentTF == "1h"
is2hour = currentTF == "120" or currentTF == "2h"
is4hour = currentTF == "240" or currentTF == "4h"
isMNQ_3m = isMNQ and is3min
isMNQ_5m = isMNQ and is5min
isMES_3m = isMES and is3min
isMES_5m = isMES and is5min
mnqKenyaActive =
     (allowMultiProfitModules_eff or (mnqProfitMode_eff == "Kenya")) and
     ((isMNQ_3m and useKenyaMnq3mProfitLogic) or (isMNQ_5m and useKenyaMnq5mProfitLogic))
htf5mBull = request.security(syminfo.tickerid, "5", (close > open) and (math.abs(close - open) > (high - low) * 0.05), barmerge.gaps_off, barmerge.lookahead_off)
htf5mBear = request.security(syminfo.tickerid, "5", (close < open) and (math.abs(close - open) > (high - low) * 0.05), barmerge.gaps_off, barmerge.lookahead_off)
permGroup = "🧭 Higher-TF Permission Chain"
mnq3mRequire5mPermission = input.bool(true, "MNQ 3m requires MNQ 5m OK", group=permGroup)
mnq5mRequire15mPermission = input.bool(true, "MNQ 5m requires MNQ 15m OK", group=permGroup)
mnq15mRequire30mPermission = input.bool(true, "MNQ 15m requires MNQ 30m OK", group=permGroup)
mes3mRequire5mPermission = input.bool(false, "MES 3m requires MES 5m OK", group=permGroup)
mes5mRequire15mPermission = input.bool(false, "MES 5m requires MES 15m OK", group=permGroup)
mes15mRequire30mPermission = input.bool(false, "MES 15m requires MES 30m OK", group=permGroup)
mnq3mAllowBigMoveBypass = input.bool(true, "MNQ 3m: allow big-move bypass of 5m permission", group=permGroup)
mes3mAllowBigMoveBypass = input.bool(true, "MES 3m: allow big-move bypass of 5m permission", group=permGroup)
permOK(tf) =>
    c = request.security(syminfo.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    e20 = request.security(syminfo.tickerid, tf, ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
    s50 = request.security(syminfo.tickerid, tf, ta.sma(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
    [c, e20, s50]
[tf5_c, tf5_e20, tf5_s50] = permOK("5")
[tf15_c, tf15_e20, tf15_s50] = permOK("15")
[tf30_c, tf30_e20, tf30_s50] = permOK("30")
mnq5mPermLong = (tf5_c > tf5_e20) and ((tf5_e20 > tf5_s50) or (tf5_c > tf5_s50))
mnq5mPermShort = (tf5_c < tf5_e20) and ((tf5_e20 < tf5_s50) or (tf5_c < tf5_s50))
mnq15mPermLong = (tf15_c > tf15_e20) and ((tf15_e20 > tf15_s50) or (tf15_c > tf15_s50))
mnq15mPermShort = (tf15_c < tf15_e20) and ((tf15_e20 < tf15_s50) or (tf15_c < tf15_s50))
mnq30mPermLong = (tf30_c > tf30_e20) and ((tf30_e20 > tf30_s50) or (tf30_c > tf30_s50))
mnq30mPermShort = (tf30_c < tf30_e20) and ((tf30_e20 < tf30_s50) or (tf30_c < tf30_s50))
mes5mPermLong = mnq5mPermLong
mes5mPermShort = mnq5mPermShort
mes15mPermLong = mnq15mPermLong
mes15mPermShort = mnq15mPermShort
mes30mPermLong = mnq30mPermLong
mes30mPermShort = mnq30mPermShort
tfMultiplier1m = isMNQ ? baseTfMultiplier1m * 1.02 : isMES ? baseTfMultiplier1m * 1.02 : isMCL ? baseTfMultiplier1m : isMGC ? baseTfMultiplier1m * 0.98 : isM2K ? baseTfMultiplier1m * 1.03 : baseTfMultiplier1m
tfMultiplier2m = isMNQ ? baseTfMultiplier2m * 1.02 : isMES ? baseTfMultiplier2m * 1.02 : isMCL ? baseTfMultiplier2m : isMGC ? baseTfMultiplier2m * 0.98 : isM2K ? baseTfMultiplier2m * 1.02 : baseTfMultiplier2m
tfMultiplier3m = isMNQ ? baseTfMultiplier3m * 1.01 : isMES ? baseTfMultiplier3m * 1.01 : isMCL ? baseTfMultiplier3m * 0.99 : isMGC ? baseTfMultiplier3m * 0.97 : isM2K ? baseTfMultiplier3m * 1.01 : baseTfMultiplier3m
tfMultiplier5m = isMNQ ? baseTfMultiplier5m * 1.0 : isMES ? baseTfMultiplier5m * 1.0 : isMCL ? baseTfMultiplier5m * 0.98 : isMGC ? baseTfMultiplier5m * 0.96 : isM2K ? baseTfMultiplier5m * 1.0 : baseTfMultiplier5m
tfMultiplier10m = isMNQ ? baseTfMultiplier10m * 0.99 : isMES ? baseTfMultiplier10m * 0.99 : isMCL ? baseTfMultiplier10m : isMGC ? baseTfMultiplier10m * 1.01 : isM2K ? baseTfMultiplier10m * 1.0 : baseTfMultiplier10m
tfMultiplier15m = isMNQ ? baseTfMultiplier15m * 0.98 : isMES ? baseTfMultiplier15m * 0.98 : isMCL ? baseTfMultiplier15m : isMGC ? baseTfMultiplier15m * 1.02 : isM2K ? baseTfMultiplier15m * 0.99 : baseTfMultiplier15m
tfMultiplier30m = isMNQ ? baseTfMultiplier30m * 0.97 : isMES ? baseTfMultiplier30m * 0.97 : isMCL ? baseTfMultiplier30m : isMGC ? baseTfMultiplier30m * 1.03 : isM2K ? baseTfMultiplier30m * 0.98 : baseTfMultiplier30m
tfMultiplier1h = isMNQ ? baseTfMultiplier1h * 0.96 : isMES ? baseTfMultiplier1h * 0.96 : isMCL ? baseTfMultiplier1h : isMGC ? baseTfMultiplier1h * 1.04 : isM2K ? baseTfMultiplier1h * 0.97 : baseTfMultiplier1h
tfMultiplier2h = isMNQ ? baseTfMultiplier2h * 0.95 : isMES ? baseTfMultiplier2h * 0.95 : isMCL ? baseTfMultiplier2h : isMGC ? baseTfMultiplier2h * 1.05 : isM2K ? baseTfMultiplier2h * 0.96 : baseTfMultiplier2h
tfMultiplier4h = isMNQ ? baseTfMultiplier4h * 0.94 : isMES ? baseTfMultiplier4h * 0.94 : isMCL ? baseTfMultiplier4h : isMGC ? baseTfMultiplier4h * 1.06 : isM2K ? baseTfMultiplier4h * 0.95 : baseTfMultiplier4h
sessionTZ = input.string("America/New_York", "Session timezone (time filters)", group=sessionGroup)
currentHourTZ = hour(time, sessionTZ)
currentMinuteTZ = minute(time, sessionTZ)
currentTime = currentHourTZ * 100 + currentMinuteTZ
currentHourCT = hour(time, "America/Chicago")
currentMinuteCT = minute(time, "America/Chicago")
currentTimeCT = currentHourCT * 100 + currentMinuteCT
isTradingHours = not enableTradingHours or ((tradingHoursStart <= tradingHoursEnd and currentTime >= tradingHoursStart and currentTime <= tradingHoursEnd) or (tradingHoursStart > tradingHoursEnd and (currentTime >= tradingHoursStart or currentTime <= tradingHoursEnd)))
isNoTradeZone = (not enable24_7Trading) and enableNoTradeZone and ((noTradeStart <= noTradeEnd and currentTime >= noTradeStart and currentTime < noTradeEnd) or (noTradeStart > noTradeEnd and (currentTime >= noTradeStart or currentTime < noTradeEnd)))
isNYOpen_opt = currentTime >= optNyOpenStart and currentTime <= optNyOpenEnd
isNYClose_opt = currentTime >= optNyCloseStart and currentTime <= optNyCloseEnd
isLondonNYOverlap_opt = currentTime >= optOverlapStart and currentTime <= optOverlapEnd
isOptimalSession = isNYOpen_opt or isNYClose_opt or isLondonNYOverlap_opt
inEodWindow =
     useEndOfDayExits and
     ((endOfDayTime <= eodBlockEndTime and currentTime >= endOfDayTime and currentTime < eodBlockEndTime) or
      (endOfDayTime > eodBlockEndTime and (currentTime >= endOfDayTime or currentTime < eodBlockEndTime)))
eodWindowStart = inEodWindow and not nz(inEodWindow[1], false)
isAsianSession = enableAsianSession and ((asianStart <= asianEnd and currentTime >= asianStart and currentTime < asianEnd) or (asianStart > asianEnd and (currentTime >= asianStart or currentTime < asianEnd)))
isLondonSession = enableLondonSession and ((londonStart <= londonEnd and currentTime >= londonStart and currentTime < londonEnd) or (londonStart > londonEnd and (currentTime >= londonStart or currentTime < londonEnd)))
isNYSession = enableNYSession and ((nyStart <= nyEnd and currentTime >= nyStart and currentTime <= nyEnd) or (nyStart > nyEnd and (currentTime >= nyStart or currentTime <= nyEnd)))
isUAESession = enableUAESession and ((uaeStart <= uaeEnd and currentTime >= uaeStart and currentTime < uaeEnd) or (uaeStart > uaeEnd and (currentTime >= uaeStart or currentTime < uaeEnd)))
tradeAllowedBySessions = isAsianSession or isLondonSession or isNYSession or isUAESession
topstepEntryBlocked = topstepExitGuard and (isMNQ or isMES) and (currentTimeCT >= topstepEntryCutoffCT)
canTradeNow =
     enable24_7Trading ? true :
     ((tradeWhen24x7Off == "Sessions" ? (tradeAllowedBySessions or isTradingHours) : isTradingHours) and not isNoTradeZone)
eodEntryBlock = blockEntriesDuringEODWindow and inEodWindow and (currentTime > tradingHoursEnd)
canEnterNow = canTradeNow and (enable24_7Trading ? true : (not eodEntryBlock)) and (not topstepEntryBlocked)
optimalSessionBonus = (useOptimalSessionsOnly and isOptimalSession) ? 1.2 : 1.0
instrumentName = isMNQ ? "MNQ" : isMES ? "MES" : isMCL ? "MCL" : isMGC ? "MGC" : isM2K ? "M2K" : "Unknown"
tpInstTag = tpInstanceTag == "AUTO" ? (instrumentName + "_" + timeframe.period) : tpInstanceTag
isOptimalForAsian = str.contains(asianBestInstruments, instrumentName)
isOptimalForLondon = str.contains(londonBestInstruments, instrumentName)
isOptimalForNY = str.contains(nyBestInstruments, instrumentName)
isOptimalForUAE = str.contains(uaeBestInstruments, instrumentName)
var float activeSessionMultiplier = 1.0
if isAsianSession and isOptimalForAsian
    activeSessionMultiplier := asianMultiplier
else if isLondonSession and isOptimalForLondon
    activeSessionMultiplier := londonMultiplier
else if isNYSession and isOptimalForNY
    activeSessionMultiplier := nyMultiplier
else if isUAESession and isOptimalForUAE
    activeSessionMultiplier := uaeMultiplier
else if (isAsianSession or isLondonSession or isUAESession)
    activeSessionMultiplier := 0.7
else
    activeSessionMultiplier := 1.0
isPreMarket = enableSessionFilters and currentTime >= preMarketStart and currentTime < regularSessionStart
isRegularSession = enableSessionFilters and currentTime >= regularSessionStart and currentTime <= regularSessionEnd
isAfterHours = enableSessionFilters and currentTime > regularSessionEnd and currentTime <= afterHoursEnd
sessionMultiplier = not enableSessionFilters ? 1.0 : isRegularSession ? 1.05 : (isPreMarket or isAfterHours) ? 0.75 : 0.6
finalSessionMultiplier = sessionMultiplier * activeSessionMultiplier * optimalSessionBonus
hma(src, len) =>
    half_length = math.max(math.round(len / 2), 1)
    sqrt_length = math.max(math.round(math.sqrt(len)), 1)
    wma_half = ta.wma(src, half_length)
    wma_full = ta.wma(src, len)
    wma_diff = 2 * wma_half - wma_full
    ta.wma(wma_diff, sqrt_length)
adaptiveHullMain = autoTimeframeOptimization ? (is1min ? math.round(hullPeriodMain * 0.7) : is2min ? math.round(hullPeriodMain * 0.8) : is3min ? math.round(hullPeriodMain * 0.85) : is5min ? math.round(hullPeriodMain * 0.9) : is10min ? math.round(hullPeriodMain * 0.95) : is15min ? hullPeriodMain : is30min ? math.round(hullPeriodMain * 1.1) : is1hour ? math.round(hullPeriodMain * 1.2) : is2hour ? math.round(hullPeriodMain * 1.3) : is4hour ? math.round(hullPeriodMain * 1.4) : hullPeriodMain) : hullPeriodMain
adaptiveHullFast = autoTimeframeOptimization ? (is1min ? math.round(hullPeriodFast * 0.8) : is2min ? math.round(hullPeriodFast * 0.85) : is3min ? math.round(hullPeriodFast * 0.9) : is5min ? hullPeriodFast : is10min ? math.round(hullPeriodFast * 1.05) : is15min ? math.round(hullPeriodFast * 1.1) : is30min ? math.round(hullPeriodFast * 1.15) : is1hour ? math.round(hullPeriodFast * 1.2) : is2hour ? math.round(hullPeriodFast * 1.25) : is4hour ? math.round(hullPeriodFast * 1.3) : hullPeriodFast) : hullPeriodFast
hullMain = hma(hullSrc, math.max(adaptiveHullMain, 2))
hullFast = hma(hullSrc, math.max(adaptiveHullFast, 2))
slopeMain = hullMain > hullMain[1] ? 1 : hullMain < hullMain[1] ? -1 : 0
slopeFast = hullFast > hullFast[1] ? 1 : hullFast < hullFast[1] ? -1 : 0
hullAnyBullish = slopeMain == 1 or slopeFast == 1
hullAnyBearish = slopeMain == -1 or slopeFast == -1
hullMicroTurn = slopeFast != slopeFast[1]
hullAcceleration = (slopeMain == slopeFast) and (slopeFast != 0)
sma9 = ta.sma(close, 9)
sma50 = ta.sma(close, 50)
sma180 = ta.sma(close, 180)
ema20 = ta.ema(close, 20)
signalTrendUp = sma9 > sma50 and sma50 > sma180
signalTrendDown = sma9 < sma50 and sma50 < sma180
res = ta.highest(high, swingPeriod)
sup = ta.lowest(low, swingPeriod)
avd = close > res[1] ? 1 : close < sup[1] ? -1 : 0
avn = ta.valuewhen(avd != 0, avd, 1)
tsl = avn == 1 ? sup : res
swingBuySignal = ta.crossover(close, tsl) and enableSwingSignals
swingSellSignal = ta.crossunder(close, tsl) and enableSwingSignals
swingColor = close >= tsl ? color.green : close <= tsl ? color.red : color.gray
dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]
adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
signalADX = adx(14, 14)
grayFactorADX = signalADX < grayADXThreshold
signalATR = ta.atr(14)
signalATRAvg = ta.sma(signalATR, 14)
grayFactorATR = signalATR < (signalATRAvg * grayATRMultiplier)
signalBBBasis = ta.sma(close, 20)
signalBBDev = ta.stdev(close, 20)
signalBBUpper = signalBBBasis + (signalBBDev * 2)
signalBBLower = signalBBBasis - (signalBBDev * 2)
signalBBWidth = (signalBBUpper - signalBBLower) / signalBBBasis
grayFactorBB = signalBBWidth < grayBBWidthThreshold
signalVolumeAvg = ta.sma(volume, 20)
grayFactorVolume = volume < (signalVolumeAvg * 0.5)
grayFactorCount = (grayFactorADX ? 1 : 0) + (grayFactorATR ? 1 : 0) + (grayFactorBB ? 1 : 0) + (grayFactorVolume ? 1 : 0)
isSignalGrayZone = grayZoneEnabled and grayFactorCount >= grayMinFactors
grayZoneWithBuffer = isSignalGrayZone or (grayZoneEnabled and grayFactorCount >= (grayMinFactors - 1))
currentATR = ta.atr(14)
candleBull = close > open
candleBear = close < open
candleBullStrict = close > open + syminfo.mintick
candleBearStrict = close < open - syminfo.mintick
bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
totalRange = high - low
bodyRatio = totalRange > 0 ? bodySize / totalRange : 0
upperWickRatio = totalRange > 0 ? upperWick / totalRange : 0
lowerWickRatio = totalRange > 0 ? lowerWick / totalRange : 0
dojiRangePct = input.float(0.05, "Doji: body <= range%", minval=0.02, maxval=0.15, step=0.01)
dojiAtrPct = input.float(0.10, "Doji: body <= ATR%", minval=0.03, maxval=0.30, step=0.01)
autoTuneDojiFilter = input.bool(true, "Auto-tune Doji filter (MNQ/MES 3m/5m)", group="🧠 Entry Block-Reason Instrumentation")
dojiRangePct_eff =
     not autoTuneDojiFilter ? dojiRangePct :
     (isMNQ and is3min) ? 0.06 :
     (isMNQ and is5min) ? 0.065 :
     (isMES and is3min) ? 0.055 :
     (isMES and is5min) ? 0.055 :
     dojiRangePct
dojiAtrPct_eff =
     not autoTuneDojiFilter ? dojiAtrPct :
     (isMNQ and is3min) ? 0.12 :
     (isMNQ and is5min) ? 0.12 :
     (isMES and is3min) ? 0.11 :
     (isMES and is5min) ? 0.11 :
     dojiAtrPct
isDojiBar =
     (totalRange > 0 and bodySize <= totalRange * dojiRangePct_eff) or
     (atr10 > 0 and bodySize <= atr10 * dojiAtrPct_eff)
hardDojiGroup = "🚫 Doji Hard Block"
hardDojiMaxBodyPct = input.float(0.20, "Hard doji: max body/range", minval=0.05, maxval=0.40, step=0.01, group=hardDojiGroup)
hardMinBodyTicks = input.int(4, "Hard doji: min body ticks", minval=1, maxval=20, group=hardDojiGroup)
hardDoji = (totalRange > 0 and (bodySize / totalRange) <= hardDojiMaxBodyPct) or (bodySize <= syminfo.mintick * hardMinBodyTicks)
minBodyRatioEntry = input.float(0.35, "Min body ratio for ALL entries", minval=0.15, maxval=0.80, step=0.01)
minBodyAtrEntry = input.float(0.12, "Min body size (×ATR10) for ALL entries", minval=0.03, maxval=0.40, step=0.01)
minBodyRatioEntry_eff =
     not enableFilterHarmony ? minBodyRatioEntry :
     isMNQ_3m ? 0.28 :
     isMNQ_5m ? 0.26 :
     isMES_3m ? 0.30 :
     isMES_5m ? 0.32 :
     minBodyRatioEntry
minBodyAtrEntry_eff =
     not enableFilterHarmony ? minBodyAtrEntry :
     isMNQ_3m ? 0.08 :
     isMNQ_5m ? 0.07 :
     isMES_3m ? 0.09 :
     isMES_5m ? 0.10 :
     minBodyAtrEntry
candleQualityOK = (not isDojiBar) and (not hardDoji) and (bodyRatio >= minBodyRatioEntry_eff) and (atr10 <= 0 or bodySize >= atr10 * minBodyAtrEntry_eff)
avgVolume = ta.sma(volume, 20)
volumeOK = not requireVolumeConfirmation or volume > avgVolume * 0.8
minCandleSize = currentATR * minPatternSize
bullishEngulfing = enableCandlePatterns and enableBullishEngulfing and candleBull and candleBear[1] and close > open[1] and open < close[1] and bodySize > minCandleSize and volumeOK
hammer = enableCandlePatterns and enableHammer and candleBull and lowerWickRatio >= 0.6 and bodyRatio <= 0.3 and totalRange > minCandleSize and volumeOK
invertedHammer = enableCandlePatterns and enableInvertedHammer and candleBull and upperWickRatio >= 0.6 and bodyRatio <= 0.3 and totalRange > minCandleSize and volumeOK
morningStar = enableCandlePatterns and enableMorningStar and candleBear[2] and bodySize[1] < bodySize[2] * 0.3 and candleBull and close > (open[2] + close[2]) / 2 and volumeOK
bullishHarami = enableCandlePatterns and enableBullishHarami and candleBear[1] and candleBull and open > close[1] and close < open[1] and bodySize < bodySize[1] * 0.5 and volumeOK
piercingLine = enableCandlePatterns and enablePiercingLine and candleBear[1] and candleBull and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1] and volumeOK
threeWhiteSoldiers = enableCandlePatterns and enableThreeWhiteSoldiers and candleBull and candleBull[1] and candleBull[2] and close > close[1] and close[1] > close[2] and open > open[1] and open[1] > open[2] and open < close[1] and open[1] < close[2] and volumeOK
bullishMarubozu = enableCandlePatterns and enableBullishMarubozu and candleBull and bodyRatio >= 0.9 and bodySize > minCandleSize * 1.2 and volumeOK
bearishEngulfing = enableCandlePatterns and enableBearishEngulfing and candleBear and candleBull[1] and close < open[1] and open > close[1] and bodySize > minCandleSize and volumeOK
shootingStar = enableCandlePatterns and enableShootingStar and candleBear and upperWickRatio >= 0.6 and bodyRatio <= 0.3 and totalRange > minCandleSize and volumeOK
hangingMan = enableCandlePatterns and enableHangingMan and candleBear and lowerWickRatio >= 0.6 and bodyRatio <= 0.3 and totalRange > minCandleSize and close[1] > close and volumeOK
eveningStar = enableCandlePatterns and enableEveningStar and candleBull[2] and bodySize[1] < bodySize[2] * 0.3 and candleBear and close < (open[2] + close[2]) / 2 and volumeOK
bearishHarami = enableCandlePatterns and enableBearishHarami and candleBull[1] and candleBear and open < close[1] and close > open[1] and bodySize < bodySize[1] * 0.5 and volumeOK
darkCloudCover = enableCandlePatterns and enableDarkCloudCover and candleBull[1] and candleBear and open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1] and volumeOK
threeBlackCrows = enableCandlePatterns and enableThreeBlackCrows and candleBear and candleBear[1] and candleBear[2] and close < close[1] and close[1] < close[2] and open < open[1] and open[1] < open[2] and open > close[1] and open[1] > close[2] and volumeOK
bearishMarubozu = enableCandlePatterns and enableBearishMarubozu and candleBear and bodyRatio >= 0.9 and bodySize > minCandleSize * 1.2 and volumeOK
doji = enableCandlePatterns and enableDoji and bodySize < currentATR * 0.1 and totalRange > minCandleSize * 0.5
spinningTop = enableCandlePatterns and enableSpinningTop and bodyRatio >= 0.2 and bodyRatio <= 0.4 and upperWickRatio >= 0.3 and lowerWickRatio >= 0.3 and totalRange > minCandleSize * 0.6
tier1Bull = threeWhiteSoldiers or bullishEngulfing
tier2Bull = morningStar or piercingLine
tier3Bull = hammer or invertedHammer or bullishHarami
tier4Bull = bullishMarubozu
tier1Bear = threeBlackCrows or bearishEngulfing
tier2Bear = eveningStar or darkCloudCover
tier3Bear = shootingStar or hangingMan or bearishHarami
tier4Bear = bearishMarubozu
isTier4Pattern = tier4Bull or tier4Bear
allowedBullPattern = (enableTier1 and tier1Bull) or (enableTier2 and tier2Bull) or (enableTier3 and tier3Bull)
allowedBearPattern = (enableTier1 and tier1Bear) or (enableTier2 and tier2Bear) or (enableTier3 and tier3Bear)
priceMovePct = math.abs((close - close[momentumLookback]) / close[momentumLookback]) * 100
momentumUpMove = close > close[momentumLookback] and priceMovePct >= momentumThresholdPct
momentumDownMove = close < close[momentumLookback] and priceMovePct >= momentumThresholdPct
mnqMomentumUpMove = isMNQ and (close - close[momentumLookback]) >= momentumThresholdPoints
mnqMomentumDownMove = isMNQ and (close[momentumLookback] - close) >= momentumThresholdPoints
hasMomentumOverrideLong = enableMomentumOverride and (momentumUpMove or mnqMomentumUpMove) and candleBull and candleQualityOK
hasMomentumOverrideShort = enableMomentumOverride and (momentumDownMove or mnqMomentumDownMove) and candleBear and candleQualityOK
maxRunBars = 6
bullOCStreak = 0
bearOCStreak = 0
upCloseStreak = 0
downCloseStreak = 0
minRunBodyRatio = input.float(0.20, "Run candle min body ratio", minval=0.05, maxval=0.70, step=0.01)
minRunBodyRatio_eff =
     (isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) ? math.min(minRunBodyRatio, 0.12) : minRunBodyRatio
for i = 0 to maxRunBars - 1
    rng_i = high[i] - low[i]
    body_i = math.abs(close[i] - open[i])
    bodyRatio_i = rng_i > 0 ? (body_i / rng_i) : 0.0
    if isDojiBar[i]
        bullOCStreak += 0
    else if (close[i] > open[i]) and bodyRatio_i >= minRunBodyRatio_eff
        bullOCStreak += 1
    if true
        break
for i = 0 to maxRunBars - 1
    rng_i = high[i] - low[i]
    body_i = math.abs(close[i] - open[i])
    bodyRatio_i = rng_i > 0 ? (body_i / rng_i) : 0.0
    if isDojiBar[i]
        bearOCStreak += 0
    else if (close[i] < open[i]) and bodyRatio_i >= minRunBodyRatio_eff
        bearOCStreak += 1
    if true
        break
for i = 0 to maxRunBars - 1
    rng_i = high[i] - low[i]
    body_i = math.abs(close[i] - open[i])
    bodyRatio_i = rng_i > 0 ? (body_i / rng_i) : 0.0
    if isDojiBar[i]
        upCloseStreak += 0
    else if (close[i] > close[i + 1]) and bodyRatio_i >= minRunBodyRatio_eff
        upCloseStreak += 1
    else
        break
for i = 0 to maxRunBars - 1
    rng_i = high[i] - low[i]
    body_i = math.abs(close[i] - open[i])
    bodyRatio_i = rng_i > 0 ? (body_i / rng_i) : 0.0
    if isDojiBar[i]
        downCloseStreak += 0
    else if (close[i] < close[i + 1]) and bodyRatio_i >= minRunBodyRatio_eff
        downCloseStreak += 1
    else
        break
runUpCloses = math.max(bullOCStreak, upCloseStreak)
runDownCloses = math.max(bearOCStreak, downCloseStreak)
runTrigGroup = "⚡ Run Trigger (Early Trend Catcher)"
enableRunTrigger = input.bool(true, "Enable run+displacement trigger (fires early)", group=runTrigGroup)
mnqRunMinTicks_3m = input.int(20, "MNQ 3m: min displacement ticks over 2 bars", minval=1, maxval=200, group=runTrigGroup)
mnqRunMinTicks_5m = input.int(24, "MNQ 5m: min displacement ticks over 2 bars", minval=1, maxval=300, group=runTrigGroup)
mesRunMinTicks_3m = input.int(8, "MES 3m: min displacement ticks over 2 bars", minval=1, maxval=200, group=runTrigGroup)
mesRunMinTicks_5m = input.int(10, "MES 5m: min displacement ticks over 2 bars", minval=1, maxval=300, group=runTrigGroup)
var int bullRunSimple = 0
var int bearRunSimple = 0
if candleBull and not hardDoji
    bullRunSimple := bullRunSimple + 1
    bearRunSimple := 0
else if candleBear and not hardDoji
    bearRunSimple := bearRunSimple + 1
    bullRunSimple := 0
var int closeUpRun = 0
var int closeDownRun = 0
if close > close[1]
    closeUpRun := closeUpRun + 1
    closeDownRun := 0
else if close < close[1]
    closeDownRun := closeDownRun + 1
    closeUpRun := 0
runUpFast = math.max(bullRunSimple, closeUpRun)
runDownFast = math.max(bearRunSimple, closeDownRun)
minRunTicks = (isMNQ and is3min) ? mnqRunMinTicks_3m :
     (isMNQ and is5min) ? mnqRunMinTicks_5m :
     (isMES and is3min) ? mesRunMinTicks_3m :
     (isMES and is5min) ? mesRunMinTicks_5m :
     0
dispTicks2 = syminfo.mintick > 0 ? math.abs(close - close[2]) / syminfo.mintick : 0.0
runTriggerLong = enableRunTrigger and (runUpFast >= 2 and runUpFast <= 3) and candleBull and not hardDoji and (dispTicks2 >= minRunTicks) and (close > close[2])
runTriggerShort = enableRunTrigger and (runDownFast >= 2 and runDownFast <= 3) and candleBear and not hardDoji and (dispTicks2 >= minRunTicks) and (close < close[2])
runTrigMinBodyPct = input.float(0.18, "Run trigger: min body/range", minval=0.05, maxval=0.60, step=0.01, group=runTrigGroup)
runTrigMinBodyAtr = input.float(0.05, "Run trigger: min body (×ATR10)", minval=0.00, maxval=0.30, step=0.01, group=runTrigGroup)
runTriggerCandleOK = (not hardDoji) and (totalRange > 0) and (bodyRatio >= runTrigMinBodyPct) and (atr10 <= 0 or bodySize >= atr10 * runTrigMinBodyAtr)
volumeMA = ta.sma(volume, 20)
isStrongVolume = volume > volumeMA * trendOverrideVolMultiplier
avgRange = ta.atr(14)
currentRange = high - low
isStrongRange = currentRange > avgRange * trendOverrideRangeMultiplier
trendStartGroup = "🔥 P-1 Trend Start"
enableTrendStart = input.bool(true, "Enable P-1 Trend Start (2nd candle)", group=trendStartGroup)
trendStartBodyMin = input.float(0.40, "P-1 min body ratio", minval=0.20, maxval=0.80, step=0.01, group=trendStartGroup)
trendStartVolMult = input.float(1.20, "P-1 volume multiple vs SMA20", minval=1.0, maxval=2.5, step=0.05, group=trendStartGroup)
trendStartAccel = input.bool(true, "P-1 require acceleration", group=trendStartGroup)
trendStartRunMin = input.int(2, "P-1 min run candles (2 catches earlier)", minval=2, maxval=4, group=trendStartGroup)
trendStartPrevVolMult = input.float(1.00, "P-1 prev candle vol mult vs SMA20", minval=0.8, maxval=2.0, step=0.05, group=trendStartGroup)
prevRange = high[1] - low[1]
prevBody = math.abs(close[1] - open[1])
prevBodyRatio = prevRange > 0 ? (prevBody / prevRange) : 0.0
trendStartBodyMin_eff =
     not enableFilterHarmony ? trendStartBodyMin :
     isMNQ_3m ? 0.34 :
     isMNQ_5m ? 0.32 :
     isMES_3m ? 0.36 :
     isMES_5m ? 0.38 :
     trendStartBodyMin
trendStartVolMult_eff =
     not enableFilterHarmony ? trendStartVolMult :
     isMNQ_3m ? 1.05 :
     isMNQ_5m ? 1.00 :
     isMES_3m ? 1.10 :
     isMES_5m ? 1.15 :
     trendStartVolMult
trendStartPrevVolMult_eff =
     not enableFilterHarmony ? trendStartPrevVolMult :
     isMNQ_3m ? 0.95 :
     isMNQ_5m ? 0.90 :
     isMES_3m ? 1.00 :
     isMES_5m ? 1.05 :
     trendStartPrevVolMult
curStrongBull = candleBull and candleQualityOK and bodyRatio >= trendStartBodyMin_eff and (volume > volumeMA * trendStartVolMult_eff)
curStrongBear = candleBear and candleQualityOK and bodyRatio >= trendStartBodyMin_eff and (volume > volumeMA * trendStartVolMult_eff)
prevStrongBull = (close[1] > open[1]) and (not isDojiBar[1]) and prevBodyRatio >= trendStartBodyMin_eff and (volume[1] > volumeMA[1] * trendStartPrevVolMult_eff)
prevStrongBear = (close[1] < open[1]) and (not isDojiBar[1]) and prevBodyRatio >= trendStartBodyMin_eff and (volume[1] > volumeMA[1] * trendStartPrevVolMult_eff)
accelBull = (close - close[1]) > (close[1] - close[2])
accelBear = (close[1] - close) > (close[2] - close[1])
hasTrendStartLong =
     enableTrendStart and (runUpCloses >= trendStartRunMin) and curStrongBull and prevStrongBull and
     (not trendStartAccel or accelBull)
hasTrendStartShort =
     enableTrendStart and (runDownCloses >= trendStartRunMin) and curStrongBear and prevStrongBear and
     (not trendStartAccel or accelBear)
hasTrendOverrideBull = enableTrendOverride and (runUpCloses >= 3) and isStrongVolume and isStrongRange and not isDojiBar
hasTrendOverrideBear = enableTrendOverride and (runDownCloses >= 3) and isStrongVolume and isStrongRange and not isDojiBar
hasStrongTrendOverrideBull = enableTrendOverride and (runUpCloses >= 4) and isStrongVolume and isStrongRange and not isDojiBar
hasStrongTrendOverrideBear = enableTrendOverride and (runDownCloses >= 4) and isStrongVolume and isStrongRange and not isDojiBar
priceRangeTrend = ta.highest(high, trendStrengthPeriod) - ta.lowest(low, trendStrengthPeriod)
trendStrength = priceRangeTrend > 0 ? math.abs(close - close[trendStrengthPeriod]) / priceRangeTrend : 0
veryStrongTrend = trendStrength > 0.25
momentumRSI = ta.rsi(close, 7)
momentumROC = ((close - close[5]) / close[5]) * 100
strongMomentumLong = momentumROC > 0.5 and momentumRSI > 55 and momentumRSI < 75
strongMomentumShort = momentumROC < -0.5 and momentumRSI < 45 and momentumRSI > 25
emaShort = ta.ema(close, 9)
emaMedium = ta.ema(close, 21)
emaLong = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
emaAlignedLong = (emaShort > emaMedium ? 1 : 0) + (emaMedium > emaLong ? 1 : 0) + (close > emaLong ? 1 : 0)
emaAlignedShort = (emaShort < emaMedium ? 1 : 0) + (emaMedium < emaLong ? 1 : 0) + (close < emaLong ? 1 : 0)
trendAlignedLong = emaAlignedLong >= 3
trendAlignedShort = emaAlignedShort >= 3
trendAlignedLongFast = (emaShort > emaMedium) and (close > emaMedium)
trendAlignedShortFast = (emaShort < emaMedium) and (close < emaMedium)
vwapVal = ta.vwap(hlc3)
vwapSlope = vwapVal - vwapVal[vwapSlopeLen]
vwapLookbackMins =
     (isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) ? 90 : 180
vwapCrossLookbackBars = int(math.max(1, math.round((vwapLookbackMins * 60.0) / timeframe.in_seconds(timeframe.period))))
vwapCrossNow = ta.cross(close, vwapVal) ? 1 : 0
int vwapCrossCount = 0
for i = 0 to vwapCrossLookbackBars - 1
    vwapCrossCount += vwapCrossNow[i]
atrBase = ta.sma(atrMain, atrExpLen)
atrExpMult_eff =
     ((isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) and (trendAlignedLongFast or trendAlignedShortFast)) ? (atrExpMult * 0.85) :
     atrExpMult
atrExpandingNow = atrBase > 0 ? (atrMain > atrBase * atrExpMult_eff) : true
emaStackBull = ema20 > emaLong and emaLong > ema200
emaStackBear = ema20 < emaLong and emaLong < ema200
vwapSlopeUp = vwapSlope > 0
vwapSlopeDown = vwapSlope < 0
htfPH = request.security(syminfo.tickerid, trendHTFTF, ta.pivothigh(high, htfPivotLen, htfPivotLen), barmerge.gaps_off, barmerge.lookahead_off)
htfPL = request.security(syminfo.tickerid, trendHTFTF, ta.pivotlow(low, htfPivotLen, htfPivotLen), barmerge.gaps_off, barmerge.lookahead_off)
htfLastHigh = ta.valuewhen(not na(htfPH), htfPH, 0)
htfPrevHigh = ta.valuewhen(not na(htfPH), htfPH, 1)
htfLastLow = ta.valuewhen(not na(htfPL), htfPL, 0)
htfPrevLow = ta.valuewhen(not na(htfPL), htfPL, 1)
htfBullStructure = not na(htfLastHigh) and not na(htfPrevHigh) and not na(htfLastLow) and not na(htfPrevLow) and htfLastHigh > htfPrevHigh and htfLastLow > htfPrevLow
htfBearStructure = not na(htfLastHigh) and not na(htfPrevHigh) and not na(htfLastLow) and not na(htfPrevLow) and htfLastHigh < htfPrevHigh and htfLastLow < htfPrevLow
htfStructureReady = not na(htfLastHigh) and not na(htfPrevHigh) and not na(htfLastLow) and not na(htfPrevLow)
compressionBypass = (runUpCloses >= 3) or (runDownCloses >= 3) or hasTrendOverrideBull or hasTrendOverrideBear or hasMomentumOverrideLong or hasMomentumOverrideShort
compressionBox = (isSignalGrayZone or isChoppy) and not compressionBypass
maxVwapCrosses_eff =
     (isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) and (atrExpandingNow and (trendAlignedLongFast or trendAlignedShortFast)) ?
         math.max(maxVwapCrosses, 5) :
         maxVwapCrosses
star_priceRangeExpanding = close > ta.highest(high, 20)[1] or close < ta.lowest(low, 20)[1]
star_directionalMomentum = emaShort > emaMedium or emaShort < emaMedium
star_increasingVelocity = math.abs(close - close[1]) > math.abs(close[1] - close[2])
star_notTightRange = true
if usePointRangeCheck and (isMES or isMNQ or isM2K)
    recentRangePoints = (ta.highest(high, 20) - ta.lowest(low, 20)) / syminfo.mintick
    requiredPoints = isMES ? minMESRangePoints / syminfo.mintick : 0.0
    star_notTightRange := requiredPoints == 0.0 ? true : recentRangePoints >= requiredPoints
star_atrExpanding = ta.atr(atrPeriod) > ta.sma(ta.atr(atrPeriod), 3)
star_volumeConfirmation = volume > ta.sma(volume, 20) * 1.2
star_trendAligned = trendAlignedLong or trendAlignedShort
starScore = 0
starScore += star_priceRangeExpanding ? 1 : 0
starScore += star_directionalMomentum ? 1 : 0
starScore += star_increasingVelocity ? 1 : 0
starScore += star_notTightRange ? 1 : 0
starScore += star_atrExpanding ? 1 : 0
starScore += star_volumeConfirmation ? 1 : 0
starScore += star_trendAligned ? 1 : 0
fiveStarOK = starScore >= minStarsRequired
is5Star = starScore >= 5
is4Star = starScore >= 4
is3Star = starScore >= 3
is2Star = starScore >= 2
mtfScore() =>
    if not enableMTF
        100
    else
        a1 = request.security(syminfo.tickerid, mtf_tf1, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off) ? 1 : -1
        a2 = request.security(syminfo.tickerid, mtf_tf2, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off) ? 1 : -1
        a3 = request.security(syminfo.tickerid, mtf_tf3, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off) ? 1 : -1
        alignPairs = (a1 == a2 ? 1 : 0) + (a1 == a3 ? 1 : 0) + (a2 == a3 ? 1 : 0)
        alignPairs == 3 ? 100 : alignPairs == 2 ? 66 : alignPairs == 1 ? 33 : 0
mtf_alignment_pct = mtfScore()
mtfBull1 = request.security(syminfo.tickerid, mtf_tf1, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtfBull2 = request.security(syminfo.tickerid, mtf_tf2, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtfBull3 = request.security(syminfo.tickerid, mtf_tf3, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtfBullCount = (mtfBull1 ? 1 : 0) + (mtfBull2 ? 1 : 0) + (mtfBull3 ? 1 : 0)
mtfBearCount = 3 - mtfBullCount
mtfDirectionalPctLong = math.round((mtfBullCount / 3.0) * 100.0)
mtfDirectionalPctShort = math.round((mtfBearCount / 3.0) * 100.0)
mtfLongOK = (not enableMTF) or (mtfMode != "Filter") or (mtfDirectionalPctLong >= mtfAlignThreshold_eff)
mtfShortOK = (not enableMTF) or (mtfMode != "Filter") or (mtfDirectionalPctShort >= mtfAlignThreshold_eff)
mtfStrictApplies = enableMTFStrictFilter and (isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m)
mtf15_Long = request.security(syminfo.tickerid, "15", close > ta.sma(close, mtfStrictSmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtf60_Long = request.security(syminfo.tickerid, "60", close > ta.sma(close, mtfStrictSmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtf15_Short = request.security(syminfo.tickerid, "15", close < ta.sma(close, mtfStrictSmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtf60_Short = request.security(syminfo.tickerid, "60", close < ta.sma(close, mtfStrictSmaLen), barmerge.gaps_off, barmerge.lookahead_off)
mtfStrictLongOK = (not mtfStrictApplies) or (mtf15_Long and mtf60_Long)
mtfStrictShortOK = (not mtfStrictApplies) or (mtf15_Short and mtf60_Short)
hierBiasLongSetup = request.security(syminfo.tickerid, hierBiasTfSetup, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
hierBiasLongTrend = request.security(syminfo.tickerid, hierBiasTfTrend, close > ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
hierBiasShortSetup = request.security(syminfo.tickerid, hierBiasTfSetup, close < ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
hierBiasShortTrend = request.security(syminfo.tickerid, hierBiasTfTrend, close < ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
hierBiasLongOK = hierBiasLongSetup and hierBiasLongTrend
hierBiasShortOK = hierBiasShortSetup and hierBiasShortTrend
effMinHTFAligned =
     (isMES and enableMesAntiChop) ? mesMinHTFAligned :
     ((isMNQ_3m or isMNQ_5m) ? math.max(minHTFAligned, 2) : minHTFAligned)
htfConfirmLongOK = (not enableHTFConfirm) or (htfAlignLongCount >= effMinHTFAligned)
htfConfirmShortOK = (not enableHTFConfirm) or (htfAlignShortCount >= effMinHTFAligned)
priceHigh = ta.highest(high, 20)
priceLow = ta.lowest(low, 20)
priceRange = priceHigh - priceLow
priceRangePct = close > 0 ? priceRange / close : 0
volBase = ta.sma(volume, 50)
volSurgeNow = (volBase > 0) and (volume >= volBase * impulseVolMult_eff)
barMove = math.abs(close - open)
impulseMove = (atr10 > 0) and (barMove >= atr10 * impulseATRMult_eff)
rangeOK = (atr10 > 0) and ((high - low) >= atr10 * impulseRangeMinATR)
bodyOK = (totalRange > 0) and (bodyRatio >= impulseBodyMin)
impulseGroup2 = "Impulse Volume Mode"
allowPriceOnlyImpulse = input.bool(false, "Allow price-only impulse (trend aligned) if volume normal", group=impulseGroup2)
impulseHugeMoveMult = input.float(1.35, "Impulse: price-displacement override (×ATR10)", minval=1.10, maxval=2.50, step=0.05, group=impulseGroup2)
impulseHugeMove = (atr10 > 0) and (barMove >= atr10 * impulseATRMult_eff * impulseHugeMoveMult)
impulseVolOK_Long = volSurgeNow or ((not isMES) and allowPriceOnlyImpulse and trendAlignedLongFast and impulseHugeMove)
impulseVolOK_Short = volSurgeNow or ((not isMES) and allowPriceOnlyImpulse and trendAlignedShortFast and impulseHugeMove)
impulseLong = enableImpulseOverride and candleBull and candleQualityOK and impulseMove and impulseVolOK_Long and rangeOK and bodyOK and canEnterNow
impulseShort = enableImpulseOverride and candleBear and candleQualityOK and impulseMove and impulseVolOK_Short and rangeOK and bodyOK and canEnterNow
earlyTrendBodyOK = (not isDojiBar) and (not hardDoji) and bodyRatio >= 0.35 and (atr10 <= 0 or bodySize >= atr10 * 0.15)
earlyTrendLong = candleBull and earlyTrendBodyOK and hullAnyBullish and (useFastEmaForEarlyTrend ? trendAlignedLongFast : trendAlignedLong) and canEnterNow and (hullMicroTurn or slopeFast == 1) and (runUpCloses < 3)
earlyTrendShort = candleBear and earlyTrendBodyOK and hullAnyBearish and (useFastEmaForEarlyTrend ? trendAlignedShortFast : trendAlignedShort) and canEnterNow and (hullMicroTurn or slopeFast == -1) and (runDownCloses < 3)
tibGroup = "⚡ Trend Ignition Engine"
enableTIB = input.bool(true, "Enable Trend Ignition (P-1)", group=tibGroup)
enableCPB = input.bool(true, "Enable Continuation Pullback (P2:CONTINUATION)", group=tibGroup)
tibRangeMult = input.float(1.25, "TIB: Range Expansion × avgRange(5)", minval=1.05, maxval=2.50, step=0.05, group=tibGroup)
tibBodyMin = input.float(0.55, "TIB: Body dominance (body/range)", minval=0.30, maxval=0.90, step=0.05, group=tibGroup)
tibRsiDeltaMin = input.float(1.0, "TIB: Min RSI delta", minval=0.2, maxval=5.0, step=0.1, group=tibGroup)
tibBreakLookback = input.int(5, "TIB: Breakout lookback (prev highs/lows)", minval=2, maxval=20, group=tibGroup)
tibVolMult = input.float(1.20, "TIB: Volume × volMA(20)", minval=0.8, maxval=3.0, step=0.05, group=tibGroup)
tibVwapDistATR = input.float(0.15, "TIB: Min dist from VWAP (×ATR10)", minval=0.00, maxval=0.60, step=0.05, group=tibGroup)
cpbMaxBars = input.int(4, "CPB: Max bars after ignition", minval=2, maxval=10, group=tibGroup)
cpbRetraceATR = input.float(0.35, "CPB: Max pullback depth (×ATR10)", minval=0.10, maxval=1.00, step=0.05, group=tibGroup)
cpbReexpandRangeMult = input.float(0.90, "CPB: Re-expansion range × avgRange(5)", minval=0.50, maxval=2.00, step=0.05, group=tibGroup)
avgRange5 = ta.sma(totalRange, 5)
rsiFast_TIB = ta.rsi(close, 7)
rsiDelta = rsiFast_TIB - rsiFast_TIB[1]
vwapDist = math.abs(close - vwapVal)
vwapDistOK = (atr10 <= 0) ? true : (vwapDist >= atr10 * tibVwapDistATR)
breakUp = close > ta.highest(high, tibBreakLookback)[1]
breakDn = close < ta.lowest(low, tibBreakLookback)[1]
tibRangeMult_eff =
     not enableFilterHarmony ? tibRangeMult :
     isMNQ_3m ? 1.15 :
     isMNQ_5m ? 1.12 :
     isMES_3m ? 1.20 :
     isMES_5m ? 1.25 :
     tibRangeMult
tibBodyMin_eff =
     not enableFilterHarmony ? tibBodyMin :
     isMNQ_3m ? 0.50 :
     isMNQ_5m ? 0.48 :
     isMES_3m ? 0.52 :
     isMES_5m ? 0.55 :
     tibBodyMin
tibRsiDeltaMin_eff =
     not enableFilterHarmony ? tibRsiDeltaMin :
     isMNQ_3m ? 0.6 :
     isMNQ_5m ? 0.5 :
     isMES_3m ? 0.8 :
     isMES_5m ? 1.0 :
     tibRsiDeltaMin
tibVolMult_eff2 =
     not enableFilterHarmony ? tibVolMult :
     isMNQ_3m ? 1.05 :
     isMNQ_5m ? 1.00 :
     isMES_3m ? 1.10 :
     isMES_5m ? 1.15 :
     tibVolMult
cpbRetraceATR_eff =
     not enableFilterHarmony ? cpbRetraceATR :
     isMNQ_3m ? 0.45 :
     isMNQ_5m ? 0.50 :
     isMES_3m ? 0.40 :
     isMES_5m ? 0.35 :
     cpbRetraceATR
cpbReexpandRangeMult_eff =
     not enableFilterHarmony ? cpbReexpandRangeMult :
     isMNQ_3m ? 0.85 :
     isMNQ_5m ? 0.85 :
     isMES_3m ? 0.90 :
     isMES_5m ? 0.92 :
     cpbReexpandRangeMult
volOK_TIB = volume >= volumeMA * tibVolMult_eff2
rangeExpOK = avgRange5 > 0 ? (totalRange >= avgRange5 * tibRangeMult_eff) : false
tibRunBypass = (isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) and (runUpCloses >= 2 or runDownCloses >= 2)
tibVolOK_Loose = volume >= volumeMA * 0.80
tibLong =
     enableTIB and candleBull and not isDojiBar and bodyRatio >= tibBodyMin_eff and rangeExpOK and (rsiDelta >= tibRsiDeltaMin_eff) and vwapDistOK and canEnterNow and
     (trendAlignedLong or trendAlignedLongFast) and
     ((breakUp and volOK_TIB) or (tibRunBypass and runUpCloses >= 2 and tibVolOK_Loose))
tibShort =
     enableTIB and candleBear and not isDojiBar and bodyRatio >= tibBodyMin_eff and rangeExpOK and (rsiDelta <= -tibRsiDeltaMin_eff) and vwapDistOK and canEnterNow and
     (trendAlignedShort or trendAlignedShortFast) and
     ((breakDn and volOK_TIB) or (tibRunBypass and runDownCloses >= 2 and tibVolOK_Loose))
impulseBreakoutLong = impulseLong or runTriggerLong or tibLong
impulseBreakoutShort = impulseShort or runTriggerShort or tibShort
var int lastIgnBar = na
var int lastIgnDir = 0
if tibLong
    lastIgnBar := bar_index
    lastIgnDir := 1
else if tibShort
    lastIgnBar := bar_index
    lastIgnDir := -1
barsFromIgn = na(lastIgnBar) ? 999999 : (bar_index - lastIgnBar)
float hiSinceIgn = high
float loSinceIgn = low
if barsFromIgn <= cpbMaxBars
    hiSinceIgn := high
    loSinceIgn := low
    for i = 0 to cpbMaxBars
        if i <= barsFromIgn
            hiSinceIgn := math.max(hiSinceIgn, high[i])
            loSinceIgn := math.min(loSinceIgn, low[i])
pullbackDepthLong = (atr10 > 0) ? math.max(0.0, (hiSinceIgn - low) / atr10) : 0.0
pullbackDepthShort = (atr10 > 0) ? math.max(0.0, (high - loSinceIgn) / atr10) : 0.0
cpbAlignLongOK = trendAlignedLong or ((isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) and trendAlignedLongFast)
cpbAlignShortOK = trendAlignedShort or ((isMNQ_3m or isMNQ_5m or isMES_3m or isMES_5m) and trendAlignedShortFast)
cpbLong = enableCPB and lastIgnDir == 1 and (barsFromIgn >= 1 and barsFromIgn <= cpbMaxBars) and (pullbackDepthLong <= cpbRetraceATR_eff) and candleBull and not isDojiBar and (avgRange5 > 0 and totalRange >= avgRange5 * cpbReexpandRangeMult_eff) and cpbAlignLongOK and canEnterNow
cpbShort = enableCPB and lastIgnDir == -1 and (barsFromIgn >= 1 and barsFromIgn <= cpbMaxBars) and (pullbackDepthShort <= cpbRetraceATR_eff) and candleBear and not isDojiBar and (avgRange5 > 0 and totalRange >= avgRange5 * cpbReexpandRangeMult_eff) and cpbAlignShortOK and canEnterNow
priceChange = close - close[5]
momentumBull = priceChange > 0
momentumBear = priceChange < 0
rsi = ta.rsi(close, 7)
momentumOK_Long = (not useMomentumFilter) or (momentumBull and rsi > 40 and rsi < 65) or hasTrendOverrideBull or impulseLong or hasMomentumOverrideLong
momentumOK_Short = (not useMomentumFilter) or (momentumBear and rsi > 35 and rsi < 60) or hasTrendOverrideBear or impulseShort or hasMomentumOverrideShort
emaTrendOK_Long = trendAlignedLong or hasTrendOverrideBull or impulseLong or hasMomentumOverrideLong
emaTrendOK_Short = trendAlignedShort or hasTrendOverrideBear or impulseShort or hasMomentumOverrideShort
adxValue = adx(14, 14)
effMinADXForEntry = (isMES and enableMesAntiChop) ? mesMinADXForEntry : minADXForEntry
v71_strictEntryOK = not enableStrictEntryFilter or (adxValue >= effMinADXForEntry and rsi >= minRSIRangeLow and rsi <= minRSIRangeHigh)
mnqStrictTF = isMNQ_3m or isMNQ_5m
mnqStrictLongOK = (not mnqStrictTF) or v71_strictEntryOK or impulseBreakoutLong
mnqStrictShortOK = (not mnqStrictTF) or v71_strictEntryOK or impulseBreakoutShort
mnqAtrExpLongOK = (not mnqStrictTF) or atrExpandingNow or impulseBreakoutLong
mnqAtrExpShortOK = (not mnqStrictTF) or atrExpandingNow or impulseBreakoutShort
mnqTrendLongOK = (not mnqStrictTF) or trendAlignedLongFast or trendAlignedLong or impulseBreakoutLong
mnqTrendShortOK = (not mnqStrictTF) or trendAlignedShortFast or trendAlignedShort or impulseBreakoutShort
strongTrendEarly = trendStrength > 0.15
isLowADX = adxValue < choppyADXThreshold
atrCurrent = ta.atr(14)
atrAvg = ta.sma(atrCurrent, 20)
isLowATR = atrCurrent < (atrAvg * choppyATRMultiplier)
bbBasis = ta.sma(close, 20)
bbDev = ta.stdev(close, 20)
bbUpper = bbBasis + (bbDev * 2)
bbLower = bbBasis - (bbDev * 2)
bbWidth = (bbUpper - bbLower) / bbBasis
isTightBB = bbWidth < choppyBBWidthThreshold
choppyCount = (isLowADX ? 1 : 0) + (isLowATR ? 1 : 0) + (isTightBB ? 1 : 0)
isChoppyRaw = choppyCount >= 2
choppyActiveWhenInPosition = not disableChoppyInPosition
choppyCheckAllowed = strategy.position_size == 0 or choppyActiveWhenInPosition
trendBypassAllowed = disableChoppyInTrend and (veryStrongTrend or strongTrendEarly)
runBypassAllowed = (runUpCloses >= 3) or (runDownCloses >= 3)
overrideBypassAllowed = hasTrendOverrideBull or hasTrendOverrideBear or hasMomentumOverrideLong or hasMomentumOverrideShort or impulseLong or impulseShort or tibLong or tibShort or cpbLong or cpbShort
isChoppy := enableChoppyFilter and choppyCheckAllowed and isChoppyRaw and not trendBypassAllowed and not runBypassAllowed and not overrideBypassAllowed
getAdaptiveEnvDev() =>
    if not autoTimeframeOptimization
        envDev
    else if is1min
        envDev * 0.9
    else if is2min
        envDev * 0.95
    else if is3min
        envDev * 0.98
    else if is5min
        envDev
    else if is10min
        envDev * 1.02
    else if is15min
        envDev * 1.05
    else if is30min
        envDev * 1.08
    else if is1hour
        envDev * 1.1
    else if is2hour
        envDev * 1.12
    else if is4hour
        envDev * 1.15
    else
        envDev
getAdaptiveEnvLength() =>
    if not autoTimeframeOptimization
        envLength
    else if is1min
        math.round(envLength * 0.8)
    else if is2min
        math.round(envLength * 0.85)
    else if is3min
        math.round(envLength * 0.9)
    else if is5min
        envLength
    else if is10min
        math.round(envLength * 1.05)
    else if is15min
        math.round(envLength * 1.1)
    else if is30min
        math.round(envLength * 1.15)
    else if is1hour
        math.round(envLength * 1.2)
    else if is2hour
        math.round(envLength * 1.25)
    else if is4hour
        math.round(envLength * 1.3)
    else
        envLength
adaptiveEnvLength = getAdaptiveEnvLength()
adaptiveEnvDev = getAdaptiveEnvDev()
smaBasis = ta.sma(close, math.max(adaptiveEnvLength, 2))
upperEnv = smaBasis * (1 + adaptiveEnvDev / 100)
lowerEnv = smaBasis * (1 - adaptiveEnvDev / 100)
mymBreakoutFactor = 1.005
microBreakoutUp = close > upperEnv * mymBreakoutFactor and volume > volumeMA * 1.2
microBreakoutDn = close < lowerEnv * (2 - mymBreakoutFactor) and volume > volumeMA * 1.2
envelopeTouch = (close >= upperEnv * (mymBreakoutFactor + 0.002)) or (close <= lowerEnv * (2 - mymBreakoutFactor - 0.002))
ph = ta.pivothigh(pivotPeriod, pivotPeriod)
pl = ta.pivotlow(pivotPeriod, pivotPeriod)
var float center = na
lastpp = not na(ph) ? ph : not na(pl) ? pl : na
if not na(lastpp)
    center := na(center) ? lastpp : (center + lastpp) / 2
else if na(center)
    center := close
atrSuperTrend = ta.atr(atrPeriod)
upBand = na(center) ? close - atrFactor * atrSuperTrend : center - atrFactor * atrSuperTrend
dnBand = na(center) ? close + atrFactor * atrSuperTrend : center + atrFactor * atrSuperTrend
var float trUp = na
var float trDn = na
var int trend = 1
trUp := close[1] > trUp[1] ? math.max(upBand, trUp[1]) : upBand
trDn := close[1] < trDn[1] ? math.min(dnBand, trDn[1]) : dnBand
trend := close > trDn[1] ? 1 : close < trUp[1] ? -1 : trend[1]
trendChange = trend != trend[1]
strongTrend = trendStrength > 0.15
rangingMarket =
     (trendStrength < 0.08) and
     (adxValue < choppyADXThreshold) and
     isTightBB and
     (not atrExpandingNow) and
     (runUpCloses < 2 and runDownCloses < 2) and
     (not trendAlignedLongFast and not trendAlignedShortFast)
moderateTrend = not strongTrend and not rangingMarket
sidewaysBlocked = isChoppy or rangingMarket or isSignalGrayZone
sidewaysAllowedLong = not sidewaysBlocked or impulseBreakoutLong
sidewaysAllowedShort = not sidewaysBlocked or impulseBreakoutShort
currentVol = ta.atr(volatilityPeriod)
avgVol = ta.sma(ta.atr(volatilityPeriod), volatilityPeriod)
normalVolatility = currentVol <= avgVol * 1.1
stoch = ta.stoch(close, high, low, stochPeriod)
stochK = ta.sma(stoch, 3)
momentumBullish = highWinRateMode ? (rsi > 40 and rsi < 65 and stochK > 25 and stochK < 75 and trendAlignedLong) : (not useMomentumFilter or (rsi > 35 and rsi < rsiOverbought and stochK > 25 and trendAlignedLong))
momentumBearish = highWinRateMode ? (rsi < 60 and rsi > 35 and stochK < 75 and stochK > 25 and trendAlignedShort) : (not useMomentumFilter or (rsi < 65 and rsi > rsiOversold and stochK < 75 and trendAlignedShort))
notOverbought = rsi < 72
notOversold = rsi > 28
strongMomentumBull = rsi > 45 and rsi < 70 and stochK > 35 and stochK < 80 and trendAlignedLong
strongMomentumBear = rsi < 55 and rsi > 30 and stochK < 65 and stochK > 20 and trendAlignedShort
microMomentumBull = (rsi > rsi[1] and stochK > stochK[1]) and strongMomentumBull
microMomentumBear = (rsi < rsi[1] and stochK < stochK[1]) and strongMomentumBear
priceUp = close > close[1]
priceDown = close < close[1]
microBuySignal = enableMicroSignals and candleBull and ((priceUp and slopeFast == 1 and slopeMain == 1) or (close > smaBasis and trend == 1 and hullAnyBullish) or microBreakoutUp)
microSellSignal = enableMicroSignals and candleBear and ((priceDown and slopeFast == -1 and slopeMain == -1) or (close < smaBasis and trend == -1 and hullAnyBearish) or microBreakoutDn)
instantBuySignal = enableInstantSignals and candleBull and ((hullMicroTurn and slopeFast == 1 and trend == 1) or (trendChange and trend == 1 and hullAnyBullish) or (envelopeTouch and slopeMain == 1))
instantSellSignal = enableInstantSignals and candleBear and ((hullMicroTurn and slopeFast == -1 and trend == -1) or (trendChange and trend == -1 and hullAnyBearish) or (envelopeTouch and slopeMain == -1))
scalpBuySignal = enableScalping and enableScalpSignals and candleBull and ((microMomentumBull and priceUp and slopeMain == 1) or (close > upperEnv and trend == 1) or (hullAcceleration and trend == 1))
scalpSellSignal = enableScalping and enableScalpSignals and candleBear and ((microMomentumBear and priceDown and slopeMain == -1) or (close < lowerEnv and trend == -1) or (hullAcceleration and trend == -1))
strongBuySignal = enableStrongSignals and candleBull and (hullAnyBullish and trend == 1 and momentumBullish and slopeMain == 1 and (veryStrongTrend or strongMomentumLong) and trendAlignedLong)
strongSellSignal = enableStrongSignals and candleBear and (hullAnyBearish and trend == -1 and momentumBearish and slopeMain == -1 and (veryStrongTrend or strongMomentumShort) and trendAlignedShort)
ultraBuySignalBase = (strongBuySignal or (microBuySignal and momentumBullish) or (instantBuySignal and slopeMain == 1) or (scalpBuySignal and veryStrongTrend)) and (not highWinRateMode or notOversold)
ultraSellSignalBase = (strongSellSignal or (microSellSignal and momentumBearish) or (instantSellSignal and slopeMain == -1) or (scalpSellSignal and veryStrongTrend)) and (not highWinRateMode or notOverbought)
ultraBuySignalBase := ultraBuySignalBase or (swingInjectToBase and allowPriority7 and swingBuySignal and enableSwingSignals and candleBull)
ultraSellSignalBase := ultraSellSignalBase or (swingInjectToBase and allowPriority7 and swingSellSignal and enableSwingSignals and candleBear)
signalAllowsLong =
     (not enableSignalLine) or
     (signalTrendUp and (not grayZoneWithBuffer or swingBuySignal)) or
     hasTrendOverrideBull or impulseLong or hasMomentumOverrideLong
signalAllowsShort =
     (not enableSignalLine) or
     (signalTrendDown and (not grayZoneWithBuffer or swingSellSignal)) or
     hasTrendOverrideBear or impulseShort or hasMomentumOverrideShort
ultraBuySignalWithSignalLine = ultraBuySignalBase and signalAllowsLong
ultraSellSignalWithSignalLine = ultraSellSignalBase and signalAllowsShort
ultraBuySignal = (enableSignalLine and useSignalLineStrict) ? ultraBuySignalWithSignalLine : ultraBuySignalBase
ultraSellSignal = (enableSignalLine and useSignalLineStrict) ? ultraSellSignalWithSignalLine : ultraSellSignalBase
