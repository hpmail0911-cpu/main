                exitIssuedThisBar := true
                lastExitReason := "MJV6U_STOP_CROSSED"
    else if strategy.position_size < 0
        float stopLoss = mjvEntryPrice + mjvStopDistance
        if useEnhancedTP
            int tp1Points = math.round((mjvUltraQuickTP * 0.5) / syminfo.mintick)
            int tp2Points = math.round((mjvFuturesTPDistance * 0.4) / syminfo.mintick)
            int tp3Points = math.round((mjvFuturesTPDistance * 0.7) / syminfo.mintick)
            int tp4Points = math.round((mjvFuturesTPDistance * 1.1) / syminfo.mintick)
            strategy.exit("MJV6U_TP1_S", from_entry="SHORT", qty_percent=60, profit=tp1Points)
            strategy.exit("MJV6U_TP2_S", from_entry="SHORT", qty_percent=25, profit=tp2Points)
            strategy.exit("MJV6U_TP3_S", from_entry="SHORT", qty_percent=10, profit=tp3Points)
            strategy.exit("MJV6U_TP4_S", from_entry="SHORT", qty_percent=5, profit=tp4Points)
        if quickExitMode and holdingPeriod >= maxHoldingBars and not exitIssuedThisBar
            strategy.close("SHORT", comment="MJV6U_TIME_EXIT_SHORT")
