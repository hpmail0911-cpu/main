tpSendEODExitAlert = input.bool(true, "TradersPost: send EXIT at end-of-day", group="TradersPost Router")
tpStrategyName = input.string("V16_STRICT_DIRECTION", "TradersPost: strategy name", group="TradersPost Router")
tpNumericFormat = input.string("strings", "TradersPost: numeric format", options=["strings", "numbers"], group="TradersPost Router")
tpInstanceTag = input.string("AUTO", "TradersPost: instance tag (for matching alerts to trades)", group="TradersPost Router")
enableTradersPostAlerts_eff = forceTradersPostAlerts ? true : enableTradersPostAlerts
tpNum(x) =>
    tpNumericFormat == "numbers" ? str.tostring(x) : '"' + str.tostring(x) + '"'
tpNumInt(x) =>
    tpNumericFormat == "numbers" ? str.tostring(x) : '"' + str.tostring(x) + '"'
tpSignalId(action, dir) =>
    str.tostring(time) + "_" + str.tostring(bar_index) + "_" + action + "_" + dir
contractTicker = (isMNQ ? tradersPostSymbolMNQ : isMES ? tradersPostSymbolMES : isM2K ? tradersPostSymbolM2K : isMCL ? tradersPostSymbolMCL : isMGC ? tradersPostSymbolMGC : tradersPostSymbol)
actualTicker = contractTicker
require5Star = input.bool(false, "V8: Require 5-Star Entry Gate")
