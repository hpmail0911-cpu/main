            lastExitReason := "MJV6U_TIME_EXIT"
        if useSmartTrailing and close > mjvEntryPrice + (mjvFuturesTPDistance * trailActivationRatio)
            float trailDistance = mjvAtr * 0.6
            strategy.exit("MJV6U_TRAIL_L", from_entry="LONG", stop=close - trailDistance)
        else if useSL
            [stopOkL_mjv6u, stopValL_mjv6u, stopCrossedL_mjv6u] = stopCheckLong(stopLoss)
            if stopOkL_mjv6u
                strategy.exit("MJV6U_SL_L", from_entry="LONG", stop=stopValL_mjv6u)
            else if stopCrossedL_mjv6u and not exitIssuedThisBar
