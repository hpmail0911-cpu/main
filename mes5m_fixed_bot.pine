     (selectedPriority == "P2:TREND") or
     (selectedPriority == "P2:STRONG_TREND")
curCandleOK = candleQualityOK and (not isDojiBar)
prevCandleOK = candleQualityOK[1] and (not isDojiBar[1])
entryOK_intrabar =
     (kenyaAllowIntrabarEntries and useKenyaMnq3mProfitLogic and isMNQ and timeframe.period == "3") or
     ((not enterOnBarClose) and (allowIntrabarForP1P2 and isPriorityIntrabar))
entryOK_barclose = barstate.isconfirmed
entryOK_nextopen = barstate.isnew
bool longCondition =
     (entryTimingMode_eff == "Intrabar" ? (entryOK_intrabar and curCandleOK and shouldEnterLong) :
      entryTimingMode_eff == "Bar Close" ? (entryOK_barclose and curCandleOK and shouldEnterLong) :
      (entryOK_nextopen and prevCandleOK and shouldEnterLong[1])) and
     not tookTradeThisBar
bool shortCondition =
     (entryTimingMode_eff == "Intrabar" ? (entryOK_intrabar and curCandleOK and shouldEnterShort) :
      entryTimingMode_eff == "Bar Close" ? (entryOK_barclose and curCandleOK and shouldEnterShort) :
      (entryOK_nextopen and prevCandleOK and shouldEnterShort[1])) and
     not tookTradeThisBar
entryOK = (entryTimingMode_eff == "Intrabar" ? entryOK_intrabar : entryTimingMode_eff == "Bar Close" ? entryOK_barclose : entryOK_nextopen)
entrySignalLongForAlert = longCondition
entrySignalShortForAlert = shortCondition
selectedPriorityForLog = selectedPriority
if longCondition and strategy.position_size == 0
    sigOff2 = 0
    activeSignalType := selectedPriorityForLog == "P-1:TREND_START" ? "IGNITION" : selectedPriorityForLog == "P2:CONTINUATION" ? "CONTINUATION" : hasMomentumOverrideLong[sigOff2] ? "MOMENTUM" : impulseLong[sigOff2] ? "IMPULSE" : hasTrendOverrideBull[sigOff2] ? "TREND" : microBuySignal[sigOff2] ? "MICRO" : instantBuySignal[sigOff2] ? "INSTANT" : scalpBuySignal[sigOff2] ? "SCALP" : strongBuySignal[sigOff2] ? "STRONG" : swingBuySignal[sigOff2] ? "SWING" : "NORMAL"
else if shortCondition and strategy.position_size == 0
    sigOff2 = 0
    activeSignalType := selectedPriorityForLog == "P-1:TREND_START" ? "IGNITION" : selectedPriorityForLog == "P2:CONTINUATION" ? "CONTINUATION" : hasMomentumOverrideShort[sigOff2] ? "MOMENTUM" : impulseShort[sigOff2] ? "IMPULSE" : hasTrendOverrideBear[sigOff2] ? "TREND" : microSellSignal[sigOff2] ? "MICRO" : instantSellSignal[sigOff2] ? "INSTANT" : scalpSellSignal[sigOff2] ? "SCALP" : strongSellSignal[sigOff2] ? "STRONG" : swingSellSignal[sigOff2] ? "SWING" : "NORMAL"
else if strategy.position_size == 0
    activeSignalType := "NONE"
getActiveQty(baseQty) =>
    int qty = baseQty
    if isMES and mes_useCustom
        qty := mes_customQty
    else if isMNQ and mnq_useCustom
        qty := mnq_customQty
    else if isMCL and mcl_useCustom
        qty := mcl_customQty
    else if isMGC and mgc_useCustom
        qty := mgc_customQty
    else if isM2K and m2k_useCustom
        qty := m2k_customQty
    qty
sigOff = 0
bool allowEntryLong = true
if require5Star and not fiveStarOK[sigOff] and not hasTrendOverrideBull[sigOff] and not (impulseLong[sigOff] and candleBull[sigOff]) and not hasMomentumOverrideLong[sigOff]
    allowEntryLong := false
if dirTripwire and longCondition and strategy.position_size == 0 and allowEntryLong and finalContractQty > 0 and not candleBullStrict
    runtime.error("DIR TRIPWIRE: attempted LONG entry without strict green candle.")
if longCondition and strategy.position_size == 0 and allowEntryLong and finalContractQty > 0 and candleBullStrict
    if enableBestSideRouter and not bypassLong and not bypassShort
        biasDir := 1
        biasLockUntilBar := bar_index + biasLockBars
        lastOppositeEntryBar := bar_index
    int qtyForEntry = finalContractQty
    int tradeQty = getActiveQty(qtyForEntry)
    strategy.entry("LONG", strategy.long, qty=tradeQty, comment="LONG " + activeSignalType + " " + selectedPriorityForLog)
    tookTradeThisBar := true
    lastLongSignalBar := bar_index
    if lastSignalDir == -1
        lastOppositeEntryBar := bar_index
    lastSignalDir := 1
    lastSignalBar := bar_index
bool allowEntryShort = true
if require5Star and not fiveStarOK[sigOff] and not hasTrendOverrideBear[sigOff] and not (impulseShort[sigOff] and candleBear[sigOff]) and not hasMomentumOverrideShort[sigOff]
    allowEntryShort := false
if dirTripwire and shortCondition and strategy.position_size == 0 and allowEntryShort and finalContractQty > 0 and not candleBearStrict
    runtime.error("DIR TRIPWIRE: attempted SHORT entry without strict red candle.")
if shortCondition and strategy.position_size == 0 and allowEntryShort and finalContractQty > 0 and candleBearStrict
    if enableBestSideRouter and not bypassLong and not bypassShort
        biasDir := -1
        biasLockUntilBar := bar_index + biasLockBars
        lastOppositeEntryBar := bar_index
    int qtyForEntryS = finalContractQty
    int tradeQtyS = getActiveQty(qtyForEntryS)
    strategy.entry("SHORT", strategy.short, qty=tradeQtyS, comment="SHORT " + activeSignalType + " " + selectedPriorityForLog)
    tookTradeThisBar := true
    lastShortSignalBar := bar_index
    if lastSignalDir == 1
        lastOppositeEntryBar := bar_index
    lastSignalDir := -1
    lastSignalBar := bar_index
v71_currentVolRatio = atrMain / ta.sma(atrMain, 20)
v71_volAdjust = enableVolatilityAdjustedExits ? (v71_currentVolRatio > 1.2 ? volAdjustFactor : 1.0) : 1.0
if mjv6UltraActive and strategy.position_size != 0 and not na(entryBar) and (allowMultiProfitModules_eff or not mnqKenyaActive)
    float mjvAtr = atr10
    float mjvTpMult = (isMNQ_3m ? mnqMJV6TPMult_3m_eff : isMNQ_5m ? mnqMJV6TPMult_5m_eff : tpMultiplier)
    float mjvStopMult = (isMNQ_3m ? mnqMJV6StopMult_3m_eff : isMNQ_5m ? mnqMJV6StopMult_5m_eff : (is1min ? 1.2 : is2min ? 1.3 : is3min ? 1.4 : 1.6))
    float mjvFuturesTPDistance = mjvAtr * mjvTpMult
    float mjvUltraQuickTP = mjvAtr * (mjvTpMult * 0.5)
