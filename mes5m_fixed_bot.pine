baseVolumeThreshold = input.float(0.6, "Base Volume Threshold", minval=0.3, maxval=1.2)
volumeThreshold = isMNQ ? baseVolumeThreshold * 0.9 : isMES ? baseVolumeThreshold * 0.9 : isMCL ? baseVolumeThreshold * 1.0 : isMGC ? baseVolumeThreshold : isM2K ? baseVolumeThreshold * 0.95 : baseVolumeThreshold
