            int tp2Points = math.round((mjvFuturesTPDistance * 0.3) / syminfo.mintick)
            int tp3Points = math.round((mjvFuturesTPDistance * 0.6) / syminfo.mintick)
            int tp4Points = math.round((mjvFuturesTPDistance * 1.0) / syminfo.mintick)
            strategy.exit("MJV6U_TP1_L", from_entry="LONG", qty_percent=60, profit=tp1Points)
            strategy.exit("MJV6U_TP2_L", from_entry="LONG", qty_percent=25, profit=tp2Points)
            strategy.exit("MJV6U_TP3_L", from_entry="LONG", qty_percent=10, profit=tp3Points)
            strategy.exit("MJV6U_TP4_L", from_entry="LONG", qty_percent=5, profit=tp4Points)
        if quickExitMode and holdingPeriod >= maxHoldingBars and not exitIssuedThisBar
